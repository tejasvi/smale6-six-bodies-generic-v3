// Referee: are the collinear failures of the Lemma E certificate at masses with mu_i + mu_j = mu_k only the
// spurious coincidence zeros (xi_k = xi_l)?  For each of the 64 sign patterns: G_1..G_4 in Q[x2,x3,x4] (xi_1 = 0),
// saturate by prod_{k<l} (xi_k - xi_l) and test whether a projective zero survives (dim of the saturation > 0).
// A surviving zero would be a genuine collinear solution of E_4 (all xi_kl != 0) at these masses.
proc runmu(list mu)
{
  ring S = 0, (x2,x3,x4), dp;
  ideal X = 0, x2, x3, x4;
  int b1; int b2; int b3; int b4; int b5; int b6; int k; int l; int j;
  int nraw = 0; int nsat = 0;
  poly D = 1;
  for (k=1; k<=4; k++) { for (l=k+1; l<=4; l++) { D = D*(X[k]-X[l]); } }
  for (b1=0; b1<=1; b1++) { for (b2=0; b2<=1; b2++) { for (b3=0; b3<=1; b3++) {
  for (b4=0; b4<=1; b4++) { for (b5=0; b5<=1; b5++) { for (b6=0; b6<=1; b6++) {
    intmat Sg[4][4];
    Sg[1,2]=1-2*b1; Sg[1,3]=1-2*b2; Sg[1,4]=1-2*b3; Sg[2,3]=1-2*b4; Sg[2,4]=1-2*b5; Sg[3,4]=1-2*b6;
    for (k=1; k<=4; k++) { for (l=1; l<k; l++) { Sg[k,l] = -Sg[l,k]; } }
    ideal I;
    for (k=1; k<=4; k++) {
      poly G = 0;
      for (l=1; l<=4; l++) { if (l != k) { poly t = Sg[k,l]*mu[l]; for (j=1; j<=4; j++) { if ((j != k) && (j != l)) { t = t*(X[k]-X[j])^2; } } G = G + t; kill t; } }
      I[k] = G; kill G;
    }
    ideal GB = std(I);
    if (dim(GB) > 0) {
      nraw++;
      ideal Ssat = sat(I, ideal(D));
      ideal SB = std(Ssat);
      if (dim(SB) > 0) { nsat++; "  genuine collinear zero survives saturation for pattern", b1,b2,b3,b4,b5,b6; }
      kill Ssat; kill SB;
    }
    kill Sg; kill I; kill GB;
  }}}}}}
  "masses", mu[1], mu[2], mu[3], mu[4], ": collinear patterns with a projective zero:", nraw, "; after saturating out xi_k = xi_l:", nsat;
}
LIB "elim.lib";
runmu(list(5,2,11,3));
runmu(list(1,1,1,2));
runmu(list(1,2,3,4));
runmu(list(2,3,5,7));
runmu(list(3,5,7,11));
quit;
