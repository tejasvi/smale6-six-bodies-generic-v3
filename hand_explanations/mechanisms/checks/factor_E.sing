ring R = 0, (ma, mb, mc), dp;
poly g = ma^8*mb^8-4*ma^8*mb^6*mc^2-4*ma^6*mb^8*mc^2+6*ma^8*mb^4*mc^4-124*ma^6*mb^6*mc^4+6*ma^4*mb^8*mc^4-4*ma^8*mb^2*mc^6-124*ma^6*mb^4*mc^6-124*ma^4*mb^6*mc^6-4*ma^2*mb^8*mc^6+ma^8*mc^8-4*ma^6*mb^2*mc^8+6*ma^4*mb^4*mc^8-4*ma^2*mb^6*mc^8+mb^8*mc^8;
print(factorize(g));
poly e = ma^2*mb^2-2*ma^2*mb*mc-2*ma*mb^2*mc+ma^2*mc^2-2*ma*mb*mc^2+mb^2*mc^2;
print("E(T) quartic divides g?"); print(reduce(g, std(ideal(e))) == 0);
quit;
