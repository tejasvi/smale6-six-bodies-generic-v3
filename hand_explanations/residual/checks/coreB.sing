// No-label family B (core level): shape (Ya,Yb,Yc) = t*(ea,eb,ec) in colour y; balance at a only; U_T; D on the three
// sides; x-coordinates Xa, Xb, Xc = 0.
LIB "elim.lib";
ring R = 0, (Pab,Pbc,Pca,Xa,Xb,t, ma,mb,mc,ea,eb,ec,k), dp;
ideal I =
  Pab^2*(Xa-Xb)*t*(ea-eb)-1,
  Pbc^2*Xb*t*(eb-ec)-1,
  Pca^2*(-Xa)*t*(ec-ea)-1,
  mb*Pab^3*(ea-eb) + mc*Pca^3*(ea-ec),
  ma*mb*Pab + mb*mc*Pbc + ma*mc*Pca;
I = sat(I, ideal(Xa*Xb*(Xa-Xb)*t*(ea-eb)*(eb-ec)*(ec-ea)));
ideal E = eliminate(I, Pab*Pbc*Pca*Xa*Xb*t);
print("family B core: elimination ideal with " + string(size(E)) + " generator(s)");
// hand: P_ca = 1, P_ab = k with mb*(ea-eb)*k^3 + mc*(ea-ec) = 0; P_bc = -ma*(mb*k+mc)/(mb*mc) (U_T);
// x-closure: ma^2 (mb k+mc)^2 (eb-ec)(ec-ea) + k^2 mb^2 mc^2 (ea-eb)(ec-ea) + k^2 ma^2 (mb k+mc)^2 (ea-eb)(eb-ec) = 0
poly F = ma^2*(mb*k+mc)^2*(eb-ec)*(ec-ea) + k^2*mb^2*mc^2*(ea-eb)*(ec-ea) + k^2*ma^2*(mb*k+mc)^2*(ea-eb)*(eb-ec);
poly H = resultant(mb*(ea-eb)*k^3 + mc*(ea-ec), F, k);
print("factors of E[1]:"); print(factorize(E[1]));
print("factors of hand H:"); print(factorize(H));
print("E[1] divides H: " + string(reduce(H, std(ideal(E[1]))) == 0));
print("H in E: " + string(reduce(H, std(E)) == 0));
quit;
