ring r = 0,(za,zb,wc,wd,Pac,Pad,Pbc,Pbd,t),dp;
ideal I = 1*za+1*zb, 2*wc+2*wd, Pac^2*za*wc+1, Pad^2*za*wd+1, Pbc^2*zb*wc+1, Pbd^2*zb*wd+1, 2*Pac+2*Pad+2*Pbc+2*Pbd, za-1, t*wc-1;
ideal G = std(I);
print("A z12 w34 at (1,1,2,2) | unit: " + string(G[1]==1) + " | dim " + string(dim(G)));
kill r;
ring r = 0,(P,Q,t),dp;
ideal I = 1*Q + 2*P, 6*P + 3*Q, t*Q - 1;
ideal G = std(I);
print("D z{13,24} w{23,14} at (1,6,2,3) | unit: " + string(G[1]==1) + " | dim " + string(dim(G)));
kill r;
ring r = 0,(zbc,wbc,Pab,Pbc,Pac),dp;
poly zab = 1; poly wab = 1; poly zac = zab + zbc; poly wac = wab + wbc;
ideal I = 4*Pab^3*zab + 4*Pac^3*zac, -1*Pab^3*zab + 4*Pbc^3*zbc, 4*Pab^3*wab + 4*Pac^3*wac, -1*Pab^3*wab + 4*Pbc^3*wbc, Pab^2*zab*wab-1, Pbc^2*zbc*wbc-1, Pac^2*zac*wac-1;
ideal G = std(I);
print("B tri123 at (1,4,4,7) | unit: " + string(G[1]==1) + " | dim " + string(dim(G)));
kill r;
ring r = 0,(zbc,wab,wbc,Pab,Pbc,Pac),dp;
poly A = 1; poly zab = 1; poly zac = zab + zbc; poly wac = wab + wbc;
ideal I = A - (4*Pab^3*zab + 1*Pac^3*zac), A - (-4*Pab^3*zab + 1*Pbc^3*zbc), 4*Pab^3*wab + 1*Pac^3*wac, -4*Pab^3*wab + 1*Pbc^3*wbc, Pab^2*zab*wab-1, Pbc^2*zbc*wbc-1, Pac^2*zac*wac-1, 4*wac + 4*wbc;
ideal G = std(I);
print("C tri123 stroke 3-4 at (4,4,1,7) | unit: " + string(G[1]==1) + " | dim " + string(dim(G)));
kill r;
ring r = 0,(zbc,wab,wbc,Pab,Pbc,Pac),dp;
poly A = 1; poly zab = 1; poly zac = zab + zbc; poly wac = wab + wbc;
ideal I = A - (4*Pab^3*zab + 2*Pac^3*zac), A - (-4*Pab^3*zab + 2*Pbc^3*zbc), 4*Pab^3*wab + 2*Pac^3*wac, -4*Pab^3*wab + 2*Pbc^3*wbc, Pab^2*zab*wab-1, Pbc^2*zbc*wbc-1, Pac^2*zac*wac-1, 4*wac + 4*wbc;
ideal G = std(I);
print("C tri123 stroke 3-4 at (4,4,2,7) (control) | unit: " + string(G[1]==1) + " | dim " + string(dim(G)));
kill r;
quit;
