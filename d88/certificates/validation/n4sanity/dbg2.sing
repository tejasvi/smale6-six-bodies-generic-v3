LIB "elim.lib";
ring r = (0,ma,mb,mc),(zbc,wab,wbc,Pab,Pbc,Pac),dp;
poly zab = 1; poly zac = zab + zbc; poly wac = wab + wbc;
ideal K2 = mb*Pab^3*wab + mc*Pac^3*wac, -ma*Pab^3*wab + mc*Pbc^3*wbc;
ideal K3 = Pab^2*zab*wab-1, Pbc^2*zbc*wbc-1, Pac^2*zac*wac-1;
ideal K4 = ma*wac + mb*wbc;
poly RA = mb*Pab^3*zab + mc*Pac^3*zac;
poly RB = -ma*Pab^3*zab + mc*Pbc^3*zbc;
ideal I = K2 + K3 + K4;
ideal S = sat(I, RA);
ideal GS = std(S);
print("generic masses: (K2+K3+K4) sat RA: dim " + string(dim(GS)) + " unit " + string(GS[1]==1));
ideal T = std(I + ideal(RA - RB));
print("generic masses: K2+K3+K4 + (RA=RB): dim " + string(dim(T)));
ideal S2 = sat(I + ideal(RA - RB), RA);
ideal GS2 = std(S2);
print("generic: (K2+K3+K4+RA=RB) sat RA: dim " + string(dim(GS2)) + " unit " + string(GS2[1]==1));
quit;
