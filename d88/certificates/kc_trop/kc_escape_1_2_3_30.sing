ring r = 65521,(X2,X3,Y1,Y2,Y3,q12,q13,q23,P14,P24,P34,Y4),dp;
ideal I = (1) - (2*q12^3*((1)-(X2))+3*q13^3*((1)-(X3))),
(X2) - (1*q12^3*((X2)-(1))+3*q23^3*((X2)-(X3))),
(X3) - (1*q13^3*((X3)-(1))+2*q23^3*((X3)-(X2))),
(Y1) - (2*q12^3*((Y1)-(Y2))+3*q13^3*((Y1)-(Y3))),
(Y2) - (1*q12^3*((Y2)-(Y1))+3*q23^3*((Y2)-(Y3))),
(Y3) - (1*q13^3*((Y3)-(Y1))+2*q23^3*((Y3)-(Y2))),
q12^2*((1)-(X2))*((Y1)-(Y2)) - 1,
q13^2*((1)-(X3))*((Y1)-(Y3)) - 1,
q23^2*((X2)-(X3))*((Y2)-(Y3)) - 1,
P14^2*(1)*(-Y4) - 1,
P24^2*(X2)*(-Y4) - 1,
P34^2*(X3)*(-Y4) - 1,
1*P14^3*(1)+2*P24^3*(X2)+3*P34^3*(X3);
ideal G = std(I);
print("char 65521 escape system unit ideal: " + string(G[1]==1) + " dim " + string(dim(G)));
kill r;
ring r = 0,(X2,X3,Y1,Y2,Y3,q12,q13,q23,P14,P24,P34,Y4),dp;
ideal I = (1) - (2*q12^3*((1)-(X2))+3*q13^3*((1)-(X3))),
(X2) - (1*q12^3*((X2)-(1))+3*q23^3*((X2)-(X3))),
(X3) - (1*q13^3*((X3)-(1))+2*q23^3*((X3)-(X2))),
(Y1) - (2*q12^3*((Y1)-(Y2))+3*q13^3*((Y1)-(Y3))),
(Y2) - (1*q12^3*((Y2)-(Y1))+3*q23^3*((Y2)-(Y3))),
(Y3) - (1*q13^3*((Y3)-(Y1))+2*q23^3*((Y3)-(Y2))),
q12^2*((1)-(X2))*((Y1)-(Y2)) - 1,
q13^2*((1)-(X3))*((Y1)-(Y3)) - 1,
q23^2*((X2)-(X3))*((Y2)-(Y3)) - 1,
P14^2*(1)*(-Y4) - 1,
P24^2*(X2)*(-Y4) - 1,
P34^2*(X3)*(-Y4) - 1,
1*P14^3*(1)+2*P24^3*(X2)+3*P34^3*(X3);
ideal G = std(I);
print("char 0 escape system unit ideal: " + string(G[1]==1) + " dim " + string(dim(G)));
kill r;
quit;
