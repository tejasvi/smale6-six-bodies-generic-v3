K = frac(QQ[m1,m2]);
R = K[D0_1,D0_2,D1_2,X8_1,X8_2,X8_3,Y8_1,Y8_2];
I = ideal((Y8_1-Y8_2)+(1)*D0_2^3*(Y8_2-Y8_1)-(m1)*D0_1^3*(Y8_1-0)+(m1)*D1_2^3*(Y8_2-0)-(m2)*D0_2^3*(Y8_1-Y8_2),D1_2^2*(X8_2-X8_3)*(0-Y8_2)-1,(m1)*(X8_2-0)-(m1)*(1)*D0_1^3*(X8_2-X8_1)-(m1)*(m2)*D1_2^3*(X8_2-X8_3),(0-Y8_2)-(1)*D0_1^3*(0-Y8_1)+(1)*D0_2^3*(Y8_2-Y8_1)+(m1)*D1_2^3*(Y8_2-0)-(m2)*D1_2^3*(0-Y8_2),(1)*(X8_1-0)+(m2)*(X8_3-0)-(1)*(m1)*D0_1^3*(X8_1-X8_2)-(m2)*(m1)*D1_2^3*(X8_3-X8_2),-(1)*(m1)*D0_1^3*(Y8_1-0)*(X8_2-0)-(m2)*(m1)*D1_2^3*(Y8_2-0)*(X8_2-0),(1)*(X8_1-0)*(Y8_1-0)-(1)*(m1)*D0_1-(1/2)*(1)*(m2)*D0_2^3*(Y8_1-0)*(X8_1-X8_3)-(1/2)*(1)*(m2)*D0_2^3*(X8_1-0)*(Y8_1-Y8_2)-(1/2)*(m1)*(m2)*D1_2^3*(X8_2-0)*(0-Y8_2),(1)*(X8_1-0)*(Y8_1-0)+(m2)*(X8_3-0)*(Y8_2-0)-(1)*(m1)*D0_1-(1)*(m2)*D0_2-(m1)*(m2)*D1_2);
G = gb I;
print(if (1_R % I) == 0 then "UNIT" else "NOTUNIT");
exit 0;
