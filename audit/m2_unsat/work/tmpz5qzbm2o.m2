K = frac(QQ[m1,m2]);
R = K[D0_1,D0_2,D1_2,X9_1,X9_2,Y8_1,Y8_2,Y8_3];
I = ideal((Y8_1-Y8_2)+(1)*D0_1^3*(Y8_2-Y8_1)-(m1)*D0_1^3*(Y8_1-Y8_2)-(m2)*D0_2^3*(Y8_1-Y8_3)+(m2)*D1_2^3*(Y8_2-Y8_3),(m1)*(X9_1-0)-(m1)*(1)*D0_1^3*(X9_1-0)-(m1)*(m2)*D1_2^3*(X9_1-X9_2),(1)*(Y8_1-0)+(m2)*(Y8_3-0)-(1)*(m1)*D0_1^3*(Y8_1-Y8_2)-(m2)*(m1)*D1_2^3*(Y8_3-Y8_2),(Y8_2-Y8_3)-(1)*D0_1^3*(Y8_2-Y8_1)+(1)*D0_2^3*(Y8_3-Y8_1)+(m1)*D1_2^3*(Y8_3-Y8_2)-(m2)*D1_2^3*(Y8_2-Y8_3),D1_2^2*(X9_1-X9_2)*(Y8_2-Y8_3)-1,-(1)*(m1)*D0_1^3*(0-X9_1)-(1)*(m2)*D0_2^3*(0-X9_2),(m1)*(X9_1-0)*(Y8_2-0)+(m2)*(X9_2-0)*(Y8_3-0)-(1)*(m1)*D0_1-(1)*(m2)*D0_2-(m1)*(m2)*D1_2,D0_1^2*(0-X9_1)*(Y8_1-Y8_2)-1);
