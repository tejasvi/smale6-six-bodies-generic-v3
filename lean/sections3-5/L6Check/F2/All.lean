/-- The totals over the 191 classes: cells, linear programs, prunes. -/
theorem f2_totals : ((List.range 191).map fun k => totals (chunksOf k)).foldl
    (fun (a, b, c) (x, y, z) => (a + x, b + y, c + z)) (0, 0, 0) = (91273, 133538490, 76087734) := by
  native_decide

/-- The number of classes with at least one cell. -/
theorem f2_classes_with_cells : ((List.range 191).filter fun k => decide (0 < (totals (chunksOf k)).1)).length = 69 := by
