      keyOfLine ((L6.F2.Data.cells_c190.splitOn "\n").toArray.getD idx "") =
        some (Xz.T.key, Xw.T.key, argminString (L6.F2.diagOf 190) Xz Xw) → ClaimMeaningIn certsOf_c190 Xz Xw
  omega

