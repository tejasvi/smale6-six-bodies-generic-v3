import CC6Full.Six.D66Poly
import Lean6.Special.K4.C4.Final
import Mathlib.Tactic.NormNum.Prime

/-!
# Bridge: the chart certificate of Lemma 7.9 from the certificate project

`C4Cert` (the hypothesis of `d66_poly`) from `lemma_7_9` of the certificate project (`Lean6.Special.K4.C4`).
Both projects write the eleven equations of §7.3 in the same order, with the same positions
`ξ = (μ₃ s, μ₃ t, −μ₁ s − μ₂ t, 0)`, but in different polynomial rings: the certificate project uses
`MvPolynomial ℕ (ZMod p)` with the variables `x₀, x₁` for `s, t`, `x₂, …, x₇` for `P₁₂, …, P₃₄` and `x₈` for `c`
(`Lean6.Special.K4.C4.eqsAt`, a list), and its charts `(a, b)` set `x_a = x_b = 1`; here the variables are
`Sum.inl 0, Sum.inl 1` and `Sum.inr 0, …, Sum.inr 6` (`C4P.eqsAt`, a family indexed by `Fin 11`).

* `eqsZ_eq`: over any commutative ring the two families of equations agree (the sums over `l ≠ k` are written
  with `filter` there and with `erase` here, and the pair indices of the two projects agree).
* `var`, `ren`: the renaming of the variables `x_n` to those of `C4P.eqs`; `ren_chartPt_inl`, `ren_chartPt_inr`:
  it sends the point of the chart `(i, j + 2)` of the certificate project to the point `C4P.chartPt i j`.
* `c4Cert`: **`C4Cert`**. The ring homomorphism `ren` maps `1` to `1` and the ideal generated by the equations on
  the chart `(i, j + 2)` into the ideal generated by the equations on the chart `(i, j)` (`Ideal.map_span`).
-/

namespace CC6Compose

open CC6Full CC6Full.Six MvPolynomial Finset

/-- `32003` is prime, by `norm_num` (so that the field `ZMod 32003` used here does not depend on a check of the
certificate project). -/
instance fact_prime_32003_std : Fact (Nat.Prime 32003) := ⟨by norm_num⟩

namespace C4Bridge

/-! ## The equations of the two projects over a commutative ring -/

section Generic

variable {R : Type*} [CommRing R]

/-- The pair indices of the two projects agree (also on the diagonal, where both are `0`). -/
theorem pairIdx_castSucc (k l : Fin 4) : (Lean6.Special.K4.C4.pairIdx k l).castSucc = C4P.pairIdx k l := by
  revert k l
  decide

omit [CommRing R] in
/-- The matrices `(P_kl)` of the two projects agree, for `P_kl` read off `y = (P₁₂, …, P₃₄, c)`. -/
theorem Pm_eq (y : Fin 7 → R) : Lean6.Special.K4.C4.Pm (fun j : Fin 6 => y j.castSucc) = C4P.Pm y := by
  funext k l
  show y (Lean6.Special.K4.C4.pairIdx k l).castSucc = y (C4P.pairIdx k l)
  rw [pairIdx_castSucc]

/-- The positions `ξ` of the two projects are the same. -/
theorem xiZ_eq (μ : Fin 4 → R) (s t : R) : Lean6.Special.K4.C4.xiZ μ s t = C4P.xi μ s t := rfl

/-- The equations of the first line agree. -/
theorem eqIZ_eq (μ ξ : Fin 4 → R) (P : Fin 4 → Fin 4 → R) (k : Fin 4) :
    Lean6.Special.K4.C4.eqIZ μ ξ P k = C4P.eqI μ ξ P k := by
  simp only [Lean6.Special.K4.C4.eqIZ, C4P.eqI, Finset.filter_ne']

/-- The bodies other than `k` and `l`. -/
theorem filter_ne_ne (k l : Fin 4) :
    (univ.filter fun j : Fin 4 => j ≠ k ∧ j ≠ l) = (univ.erase k).erase l := by
  ext j
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, and_true, Finset.mem_erase]
  tauto

/-- The equations of the second line agree. -/
theorem eqIIZ_eq (μ ξ : Fin 4 → R) (P : Fin 4 → Fin 4 → R) (c : R) (k : Fin 4) :
    Lean6.Special.K4.C4.eqIIZ μ ξ P c k = C4P.eqII μ ξ P c k := by
  simp only [Lean6.Special.K4.C4.eqIIZ, C4P.eqII, Finset.filter_ne', filter_ne_ne]

/-- The triangle equations are the same. -/
theorem eqIIIZ_eq (ξ : Fin 4 → R) (P : Fin 4 → Fin 4 → R) (k l n : Fin 4) :
    Lean6.Special.K4.C4.eqIIIZ ξ P k l n = C4P.eqIII ξ P k l n := rfl

/-- **The eleven equations of the two projects agree**: the list `eqsZ` of the certificate project at
`(s, t, P, c)` is the family `C4P.eqsAt` at `(s, t, y)`, `y = (P₁₂, …, P₃₄, c)`. -/
theorem eqsZ_eq (μ : Fin 4 → R) (s t : R) (y : Fin 7 → R) :
    Lean6.Special.K4.C4.eqsZ μ s t (fun j : Fin 6 => y j.castSucc) (y 6) = List.ofFn (C4P.eqsAt μ s t y) := by
  simp only [Lean6.Special.K4.C4.eqsZ, Pm_eq, xiZ_eq, eqIZ_eq, eqIIZ_eq, eqIIIZ_eq, List.ofFn_succ,
    List.ofFn_zero]
  rfl

/-- The equations of the certificate project at a point `x` (`s = x₀`, `t = x₁`, `P₁₂, …, P₃₄, c = x₂, …, x₈`) are
`C4P.eqsAt` at `(s, t, y)` with `y_j = x_{j+2}`. -/
theorem eqsAt_eq (μ : Fin 4 → R) (x : ℕ → R) (s t : R) (y : Fin 7 → R) (hs : x 0 = s) (ht : x 1 = t)
    (hy : ∀ j : Fin 7, x ((j : ℕ) + 2) = y j) :
    Lean6.Special.K4.C4.eqsAt μ x = List.ofFn (C4P.eqsAt μ s t y) := by
  have hP : (fun j : Fin 6 => x ((j : ℕ) + 2)) = fun j => y j.castSucc := funext fun j => hy j.castSucc
  have h8 : x 8 = y 6 := hy 6
  show Lean6.Special.K4.C4.eqsZ μ (x 0) (x 1) (fun j : Fin 6 => x ((j : ℕ) + 2)) (x 8) = _
  rw [hP, h8, hs, ht, eqsZ_eq]

end Generic

/-! ## The renaming of the variables -/

/-- The variables `x₀, …, x₈` of the certificate project as variables of `C4P.eqs`: `x₀, x₁` are `s, t`
(`Sum.inl 0`, `Sum.inl 1`) and `x_{j+2}` is `Sum.inr j` for `j < 7` (`P₁₂, …, P₃₄, c`); the other indices do not
occur in the equations. -/
def var (n : ℕ) : Fin 2 ⊕ Fin 7 :=
  if h : n < 2 then Sum.inl ⟨n, h⟩ else if h' : n - 2 < 7 then Sum.inr ⟨n - 2, h'⟩ else Sum.inl 0

theorem var_inl (i : Fin 2) : var i = Sum.inl i := by
  rw [var, dite_eq_left i.isLt]

theorem var_inr (j : Fin 7) : var ((j : ℕ) + 2) = Sum.inr j := by
  have hj := j.isLt
  have h1 : ¬ ((j : ℕ) + 2 < 2) := by omega
  have h2 : (j : ℕ) + 2 - 2 < 7 := by omega
  rw [var, dite_eq_right h1, dite_eq_left h2]
  exact congrArg Sum.inr (Fin.ext (by simp))

/-- The renaming as a ring homomorphism from the polynomial ring of the certificate project. -/
noncomputable def ren : MvPolynomial ℕ (ZMod 32003) →+* MvPolynomial (Fin 2 ⊕ Fin 7) (ZMod 32003) :=
  (rename var).toRingHom

theorem ren_apply (f : MvPolynomial ℕ (ZMod 32003)) : ren f = rename var f := rfl

/-- The coordinates `s, t` of the point of the chart `(i, j + 2)` are sent to those of `C4P.chartPt i j`. -/
theorem ren_chartPt_inl (i i' : Fin 2) (j : Fin 7) :
    ren (Lean6.Special.K4.C4.chartPt 32003 ((i : ℕ), (j : ℕ) + 2) (i' : ℕ)) = C4P.chartPt i j (Sum.inl i') := by
  have hi := i'.isLt
  have hiff : ((i' : ℕ) = (i : ℕ) ∨ (i' : ℕ) = (j : ℕ) + 2) ↔ i' = i := by
    rw [Fin.ext_iff]
    constructor
    · rintro (h | h)
      · exact h
      · omega
    · exact Or.inl
  rw [ren_apply]
  show rename var (if (i' : ℕ) = (i : ℕ) ∨ (i' : ℕ) = (j : ℕ) + 2 then (1 : MvPolynomial ℕ (ZMod 32003))
      else X (i' : ℕ)) = (if i' = i then (1 : MvPolynomial (Fin 2 ⊕ Fin 7) (ZMod 32003)) else X (Sum.inl i'))
  by_cases h : i' = i
  · rw [ite_eq_left (hiff.mpr h), ite_eq_left h, map_one]
  · rw [ite_eq_right (mt hiff.mp h), ite_eq_right h, rename_X, var_inl]

/-- The coordinates `P₁₂, …, P₃₄, c` of the point of the chart `(i, j + 2)` are sent to those of
`C4P.chartPt i j`. -/
theorem ren_chartPt_inr (i : Fin 2) (j j' : Fin 7) :
    ren (Lean6.Special.K4.C4.chartPt 32003 ((i : ℕ), (j : ℕ) + 2) ((j' : ℕ) + 2)) =
      C4P.chartPt i j (Sum.inr j') := by
  have hi := i.isLt
  have hiff : ((j' : ℕ) + 2 = (i : ℕ) ∨ (j' : ℕ) + 2 = (j : ℕ) + 2) ↔ j' = j := by
    rw [Fin.ext_iff]
    constructor
    · rintro (h | h)
      · omega
      · omega
    · intro h
      right
      omega
  rw [ren_apply]
  show rename var (if (j' : ℕ) + 2 = (i : ℕ) ∨ (j' : ℕ) + 2 = (j : ℕ) + 2 then (1 : MvPolynomial ℕ (ZMod 32003))
      else X ((j' : ℕ) + 2)) =
    (if j' = j then (1 : MvPolynomial (Fin 2 ⊕ Fin 7) (ZMod 32003)) else X (Sum.inr j'))
  by_cases h : j' = j
  · rw [ite_eq_left (hiff.mpr h), ite_eq_left h, map_one]
  · rw [ite_eq_right (mt hiff.mp h), ite_eq_right h, rename_X, var_inr]

/-- The masses `[3, 5, 7, 11]` of the certificate project are `μ₀`. -/
theorem muOf_eq : (Lean6.Special.K4.C4.muOf [3, 5, 7, 11] : Fin 4 → MvPolynomial (Fin 2 ⊕ Fin 7) (ZMod 32003)) =
    fun l => C (C4P.μ₀ l) := by
  funext l
  fin_cases l <;> simp [Lean6.Special.K4.C4.muOf, C4P.μ₀, map_ofNat]

/-- The chart `(i, j)` of `C4Cert` is the chart `(i, j + 2)` of the certificate project. -/
theorem mem_charts (i : Fin 2) (j : Fin 7) : ((i : ℕ), (j : ℕ) + 2) ∈ Lean6.Special.Comp.C4.charts := by
  revert i j
  decide

end C4Bridge

open C4Bridge in
/-- **`C4Cert`** (Lemma 7.9 over `𝔽_32003`, the hypothesis of `d66_poly`) from `lemma_7_9` of the certificate
project: on the chart `(i, j)`, the image under `ren` of the identity `1 ∈ (equations on the chart (i, j + 2))`
of the certificate project. -/
theorem c4Cert_of (h : Lean6.Special.K4.C4.NoZero [3, 5, 7, 11] 32003 ∧
    Lean6.Special.K4.C4.UnitIdeal [3, 5, 7, 11] 32003) : C4Cert := by
  rw [C4Cert_iff]
  intro i j
  have h := h.2 ((i : ℕ), (j : ℕ) + 2) (mem_charts i j)
  have h1 := Ideal.mem_map_of_mem ren h
  rw [map_one, Ideal.map_span] at h1
  refine Ideal.span_mono ?_ h1
  rintro _ ⟨e, he, rfl⟩
  rw [Set.mem_ofPred_eq] at he
  have hmem : ren e ∈ (Lean6.Special.K4.C4.eqsAt (Lean6.Special.K4.C4.muOf [3, 5, 7, 11])
      (Lean6.Special.K4.C4.chartPt 32003 ((i : ℕ), (j : ℕ) + 2))).map ren := List.mem_map_of_mem he
  rw [← Lean6.Special.K4.C4.eqsAt_map,
    eqsAt_eq (Lean6.Special.K4.C4.muOf [3, 5, 7, 11])
      (fun n => ren (Lean6.Special.K4.C4.chartPt 32003 ((i : ℕ), (j : ℕ) + 2) n)) _ _ _
      (ren_chartPt_inl i 0 j) (ren_chartPt_inl i 1 j) (ren_chartPt_inr i j),
    muOf_eq, List.mem_ofFn] at hmem
  exact hmem

theorem c4Cert : C4Cert := c4Cert_of Lean6.Special.K4.C4.lemma_7_9.1

end CC6Compose
