import CC6Full.Algebra.GoodRed
import CC6Full.Algebra.PointCount

/-!
# Finiteness from torus certificates

A variant of `goodred` (`CC6Full.Algebra.GoodRed`) whose certificate hypothesis is stated as the
absence of common zeros of the initial forms in the torus over every field receiving the residue
field, instead of a cofactor identity.

## Setting

As in `CC6Full.Algebra.GoodRed`: `O` is a local ring with residue field `k = ResidueField O`, `G`
is a finite set of polynomials in `MvPolynomial (Fin N) O`, and for a linearly ordered additive
commutative group `Γ` and `w : Fin N → Γ`, `initForm w g ∈ k[X]` is the initial form of `g` at
`w` (the terms of `g` of least weight `⟨α, w⟩`, with the coefficients reduced to `k`).

The torus certificate `TropCertTorus G`: for every linearly ordered additive commutative group `Γ`
(in the universe of `O`) and every `w : Fin N → Γ` with some `w i < 0`, for every field `K` (in the
universe of `O`) with a ring homomorphism `φ : k →+* K`, and for every `y : Fin N → K` with all
`y i ≠ 0`, some `g ∈ G` has `in_w(g)(y) ≠ 0`, the coefficients of `in_w(g)` being mapped to `K` by
`φ`.

For `O = Opt p μ₀ = ℤ[μ]_𝔪` (`CC6Full.Algebra.PointCount`), whose residue field is `𝔽_p` through
`resPt`, the certificate `TropCertTorusOpt p μ₀ G` is stated over the fields `K` of characteristic
`p`, with the initial forms reduced to `𝔽_p` by `resPt` (`initFormOpt`) and mapped to `K` by the
canonical map `ZMod.castHom : ZMod p →+* K`.

## Main statements

* `tropCert_of_tropCertTorus`: `TropCertTorus G` implies the certificate `TropCert G` of `goodred`
  (through its second alternative).
* `goodred_torus`: under the hypotheses of `goodred` with `TropCertTorus G` in place of
  `TropCert G`, `A ⧸ I` is integral over `O`.
* `tropCertTorus_of_opt`: `TropCertTorusOpt p μ₀ G` implies `TropCertTorus G`.
* `goodred_torus_opt`: the case `O = Opt p μ₀` of `goodred_torus`, with the hypothesis
  `TropCertTorusOpt p μ₀ G`.

## Proof

* `tropCert_of_tropCertTorus`: let `J ⊆ k[X]` be the ideal generated by the initial forms at `w` of
  the elements of `G`. If no power of `∏ i, X i` lies in `J`, some prime ideal `P ⊇ J` does not
  contain `∏ i, X i` (`Ideal.radical_eq_sInf`), hence contains no `X i`. In the fraction field `K`
  of `k[X] ⧸ P`, a field receiving `k`, the images `y i` of the `X i` are nonzero and every initial
  form vanishes at `y`, which contradicts `TropCertTorus G`. So `(∏ i, X i) ^ a ∈ J` for some `a`,
  which gives the cofactors. (In the proof of `goodred`, the second alternative of `TropCert G` is
  used only to exclude a common zero of the initial forms in the torus over the residue field of a
  valuation ring, which is a field receiving `k`.)
* `tropCertTorus_of_opt`: a field `K` receiving the residue field of `Opt p μ₀` has characteristic
  `p`, and the homomorphism is `resPt` followed by `ZMod.castHom`: both send the residue of `a` to
  the image of an integer `n` with `resPt a = n`.
-/

namespace CC6Full

open MvPolynomial IsLocalRing

noncomputable section

universe u

variable {N : ℕ}

/-! ### The torus certificate -/

/-- The torus certificate for a finite set `G` of polynomials over the local ring `O`: for every
linearly ordered additive commutative group `Γ` (in the universe of `O`) and every
`w : Fin N → Γ` with some `w i < 0`, for every field `K` (in the universe of `O`) with a ring
homomorphism `φ` from the residue field of `O`, and for every `y : Fin N → K` with all `y i ≠ 0`,
some `g ∈ G` has its initial form at `w`, with the coefficients mapped to `K` by `φ`, nonzero
at `y`. -/
def TropCertTorus {O : Type u} [CommRing O] [IsLocalRing O] (G : Finset (MvPolynomial (Fin N) O)) :
    Prop :=
  ∀ (Γ : Type u) [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ] (w : Fin N → Γ),
    (∃ i, w i < 0) →
      ∀ (K : Type u) [Field K] (φ : ResidueField O →+* K) (y : Fin N → K), (∀ i, y i ≠ 0) →
        ∃ g ∈ G, eval y (map φ (initForm w g)) ≠ 0

/-- The torus certificate implies the certificate `TropCert` of `goodred` (through its second
alternative): a power of `∏ i, X i` is a combination of the initial forms. -/
theorem tropCert_of_tropCertTorus {O : Type u} [CommRing O] [IsLocalRing O]
    {G : Finset (MvPolynomial (Fin N) O)} (hcert : TropCertTorus G) : TropCert G := by
  classical
  intro Γ _ _ _ w hw
  right
  -- the ideal of the initial forms
  let J : Ideal (MvPolynomial (Fin N) (ResidueField O)) :=
    Ideal.span (Set.range fun g : G => initForm w (g : MvPolynomial (Fin N) O))
  have hrad : (∏ i, X i : MvPolynomial (Fin N) (ResidueField O)) ∈ J.radical := by
    by_contra hnot
    rw [Ideal.radical_eq_sInf, Ideal.mem_sInf] at hnot
    push Not at hnot
    obtain ⟨P, ⟨hJP, hP⟩, hXP⟩ := hnot
    -- the fraction field of `k[X] ⧸ P`
    let Q := MvPolynomial (Fin N) (ResidueField O) ⧸ P
    let K := FractionRing Q
    let ψ : MvPolynomial (Fin N) (ResidueField O) →+* K :=
      (algebraMap Q K).comp (Ideal.Quotient.mk P)
    have hψ : ∀ x, ψ x = 0 ↔ x ∈ P := fun x => by
      change algebraMap Q K (Ideal.Quotient.mk P x) = 0 ↔ x ∈ P
      rw [map_eq_zero_iff _ (IsFractionRing.injective Q K), Ideal.Quotient.eq_zero_iff_mem]
    have hy : ∀ i, ψ (X i) ≠ 0 := fun i hi =>
      hXP (Ideal.prod_mem P (Finset.mem_univ i) ((hψ _).1 hi))
    have heval : ∀ x, eval (fun i => ψ (X i)) (map (ψ.comp C) x) = ψ x := fun x => by
      rw [eval_map, ← hom_eval₂, eval₂_eta]
    obtain ⟨g, hg, hne⟩ := hcert Γ w hw K (ψ.comp C) (fun i => ψ (X i)) hy
    apply hne
    rw [heval, hψ]
    exact hJP (Ideal.subset_span ⟨⟨g, hg⟩, rfl⟩)
  obtain ⟨a, ha⟩ := hrad
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.1 ha
  refine ⟨a, fun g => if hg : g ∈ G then c ⟨g, hg⟩ else 0, ?_⟩
  rw [← hc, ← Finset.sum_coe_sort (s := G)]
  refine Finset.sum_congr rfl fun g _ => ?_
  simp only [dite_eq_left g.2, Subtype.coe_eta]

/-- **Finiteness from torus certificates.** Under the hypotheses of `goodred`, with the torus
certificate `TropCertTorus G` in place of `TropCert G`: let `O` be a Noetherian local ring, `I` an
ideal of `A = O[v_1, …, v_r]`, and `ξ : Fin N → A` with each `ξ i` a unit modulo `I` and each
`v_j` congruent modulo `I` to a polynomial in the `ξ i` over `O`. Let `G` be a finite set of
polynomials over `O` whose coefficients are units, with `g(ξ) ∈ I` for `g ∈ G`, satisfying
`TropCertTorus G`. Then `A ⧸ I` is integral over `O`. -/
theorem goodred_torus {O : Type u} [CommRing O] [IsLocalRing O] [IsNoetherianRing O] {r : ℕ}
    (I : Ideal (MvPolynomial (Fin r) O))
    (ξ : Fin N → MvPolynomial (Fin r) O) (hξ : ∀ i, IsUnit (Ideal.Quotient.mk I (ξ i)))
    (hX : ∀ j, ∃ p : MvPolynomial (Fin N) O, X j - aeval ξ p ∈ I)
    (G : Finset (MvPolynomial (Fin N) O)) (hG : ∀ g ∈ G, ∀ α ∈ g.support, IsUnit (g.coeff α))
    (hGI : ∀ g ∈ G, aeval ξ g ∈ I) (hcert : TropCertTorus G) :
    Algebra.IsIntegral O (MvPolynomial (Fin r) O ⧸ I) :=
  goodred I ξ hξ hX G hG hGI (tropCert_of_tropCertTorus hcert)

/-! ### The local ring `Opt p μ₀`, with residue field `𝔽_p` -/

section Opt

variable (p : ℕ) [Fact p.Prime] {r : ℕ} (μ₀ : Fin r → ℤ)

/-- The initial form of `g` at `w`, with the coefficients reduced to `𝔽_p` by `resPt`: the sum of
the terms of `g` whose exponents lie in the initial pattern of `g` at `w`. -/
def initFormOpt {Γ : Type*} [AddCommMonoid Γ] [LinearOrder Γ] (w : Fin N → Γ)
    (g : MvPolynomial (Fin N) (Opt p μ₀)) : MvPolynomial (Fin N) (ZMod p) :=
  ∑ α ∈ initPattern w g, monomial α (resPt p μ₀ (g.coeff α))

/-- The torus certificate for a finite set `G` of polynomials over `Opt p μ₀`, over the fields of
characteristic `p`: for every linearly ordered additive commutative group `Γ` and every
`w : Fin N → Γ` with some `w i < 0`, for every field `K` of characteristic `p`, and for every
`y : Fin N → K` with all `y i ≠ 0`, some `g ∈ G` has its initial form at `w`, with the
coefficients reduced to `𝔽_p` and mapped to `K` by the canonical map `ZMod p →+* K`, nonzero
at `y`. -/
def TropCertTorusOpt (G : Finset (MvPolynomial (Fin N) (Opt p μ₀))) : Prop :=
  ∀ (Γ : Type) [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ] (w : Fin N → Γ),
    (∃ i, w i < 0) →
      ∀ (K : Type) [Field K] [CharP K p] (y : Fin N → K), (∀ i, y i ≠ 0) →
        ∃ g ∈ G, eval y (map (ZMod.castHom (dvd_refl p) K) (initFormOpt p μ₀ w g)) ≠ 0

/-- A field receiving the residue field of `Opt p μ₀` has characteristic `p`. -/
theorem charP_of_residueField_opt {K : Type*} [Field K] (φ : ResidueField (Opt p μ₀) →+* K) :
    CharP K p := by
  rw [CharP.charP_iff_prime_eq_zero (Fact.out : p.Prime)]
  have h : residue (Opt p μ₀) (p : Opt p μ₀) = 0 := by
    rw [residue_eq_zero_iff, ← ker_resPt p μ₀, RingHom.mem_ker, map_natCast, ZMod.natCast_self]
  rw [← map_natCast φ p, ← map_natCast (residue (Opt p μ₀)) p, h, map_zero]

/-- A ring homomorphism from the residue field of `Opt p μ₀` to a field `K` of characteristic `p`
sends the residue of `a` to the image of `resPt p μ₀ a` under the canonical map `ZMod p →+* K`. -/
theorem residueField_opt_hom_residue {K : Type*} [Field K] [CharP K p]
    (φ : ResidueField (Opt p μ₀) →+* K) (a : Opt p μ₀) :
    φ (residue (Opt p μ₀) a) = ZMod.castHom (dvd_refl p) K (resPt p μ₀ a) := by
  obtain ⟨n, hn⟩ := ZMod.intCast_surjective (resPt p μ₀ a)
  have h : residue (Opt p μ₀) a = n := by
    rw [← sub_eq_zero, ← map_intCast (residue (Opt p μ₀)) n, ← map_sub, residue_eq_zero_iff,
      ← ker_resPt p μ₀, RingHom.mem_ker, map_sub, map_intCast, hn, sub_self]
  rw [h, map_intCast, ← hn, map_intCast]

/-- The torus certificate over the fields of characteristic `p` implies the torus certificate. -/
theorem tropCertTorus_of_opt {G : Finset (MvPolynomial (Fin N) (Opt p μ₀))}
    (hcert : TropCertTorusOpt p μ₀ G) : TropCertTorus G := by
  intro Γ _ _ _ w hw K _ φ y hy
  have := charP_of_residueField_opt p μ₀ φ
  obtain ⟨g, hg, hne⟩ := hcert Γ w hw K y hy
  refine ⟨g, hg, ?_⟩
  have h : map φ (initForm w g) = map (ZMod.castHom (dvd_refl p) K) (initFormOpt p μ₀ w g) := by
    simp only [initForm, initFormOpt, map_sum, map_monomial, residueField_opt_hom_residue]
  rwa [h]

/-- **Finiteness from torus certificates over `𝔽_p`.** `goodred_torus` for `O = Opt p μ₀`, with
the certificate stated over the fields of characteristic `p`: let `I` be an ideal of
`A = O[v_1, …, v_m]`, and `ξ : Fin N → A` with each `ξ i` a unit modulo `I` and each `v_j`
congruent modulo `I` to a polynomial in the `ξ i` over `O`. Let `G` be a finite set of polynomials
over `O` whose coefficients are units, with `g(ξ) ∈ I` for `g ∈ G`, satisfying
`TropCertTorusOpt p μ₀ G`. Then `A ⧸ I` is integral over `O`. -/
theorem goodred_torus_opt {m : ℕ} (I : Ideal (MvPolynomial (Fin m) (Opt p μ₀)))
    (ξ : Fin N → MvPolynomial (Fin m) (Opt p μ₀)) (hξ : ∀ i, IsUnit (Ideal.Quotient.mk I (ξ i)))
    (hX : ∀ j, ∃ q : MvPolynomial (Fin N) (Opt p μ₀), X j - aeval ξ q ∈ I)
    (G : Finset (MvPolynomial (Fin N) (Opt p μ₀)))
    (hG : ∀ g ∈ G, ∀ α ∈ g.support, IsUnit (g.coeff α))
    (hGI : ∀ g ∈ G, aeval ξ g ∈ I) (hcert : TropCertTorusOpt p μ₀ G) :
    Algebra.IsIntegral (Opt p μ₀) (MvPolynomial (Fin m) (Opt p μ₀) ⧸ I) :=
  goodred_torus I ξ hξ hX G hG hGI (tropCertTorus_of_opt p μ₀ hcert)

end Opt

end

end CC6Full
