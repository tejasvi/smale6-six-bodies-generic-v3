import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.Algebra.Order.Antidiag.Finsupp
import Mathlib.Data.ZMod.Basic

/-!
# Macaulay matrices and the transfer of a certificate from one parameter point (homogeneous case)

Proposition 7.8 (`prop:E4`) of the paper shows that the set of parameters `μ` for which a family of forms has a
common projective zero is a proper Zariski-closed set, by projective elimination and a computation at one point.
Here the elimination is replaced by linear algebra over the coefficient ring.

Let `f_1, …, f_s ∈ A[q_1, …, q_N]` be forms of degrees `d_1, …, d_s`, where `A` is the coefficient ring (for
`prop:E4`, `A = ℤ[j][μ_1, …, μ_4]`, or `ℤ[j]` once the masses are fixed). For a degree `D` the *Macaulay matrix*
`M` has a row for each pair `(i, u)` with `u` a monomial of degree `D - d_i`, a column for each monomial `v` of
degree `D`, and the entry `coeff_v (q^u f_i)`. A choice `S` of as many rows as columns gives a square matrix `M_S`
and a *maximal minor* `h = det M_S ∈ A`.

* `eq_zero_of_macaulayMinor_ne_zero` (item (a)): over a field, if `det M_S ≠ 0` then every monomial of degree `D`
  is a linear combination of the `q^u f_i` with `(i, u) ∈ S` (`monomial_mem_span_of_macaulayMinor_ne_zero`), so
  every common zero `q` of the forms is `0` (if `q_k ≠ 0` then `q_k^D ≠ 0`).
* `eq_zero_of_map_macaulayMinor_ne_zero`, `macaulay_transfer` (item (b)): for a specialization `φ : A →+* K` of the
  coefficients into a field (evaluation at a parameter point `μ`), `φ (det M_S) = det (φ M_S)`, so `φ h ≠ 0`
  implies that the specialized forms have no common zero `q ≠ 0`. With `A = R[μ]`: if `h(μ₀) ≠ 0` at one point
  then `h ≠ 0`, and the forms have no common nonzero zero off the hypersurface `h = 0`.
* `det_ne_zero_of_map_mul_eq_one`, `eq_zero_of_macaulay_certificate`, `macaulay_transfer_certificate` (item (c)):
  a certificate is a ring map `φ` from the coefficient ring to a nontrivial ring such as `ZMod p` (for example
  `ℤ[j] → 𝔽_p`) and a matrix `W` with `φ(M_S(μ₀)) · W = 1`; then `φ (det M_S(μ₀)) ≠ 0`, hence `det M_S(μ₀) ≠ 0`.
  `macaulay_transfer_certificate_reindex` takes the certificate as matrices indexed by any type (for example
  `Fin k`), through an enumeration of the monomials of degree `D` (`macaulayMinor_reindex`).
* `exists_macaulayMinor_ne_zero_of_rank`: full column rank of the specialized Macaulay matrix gives a nonzero
  specialized maximal minor (`exists_submatrix_det_ne_zero`), so a rank computation is also a certificate.

The general part (`macaulay`, `monomial_eq_sum_of_isUnit_det`, `exists_submatrix_det_ne_zero`) does not depend on
the grading and is also used for the bihomogeneous case of Proposition 7.11 (`CC6Full.Algebra.MacaulayBi`).
-/

namespace CC6Full

open MvPolynomial Finset

noncomputable section

/-! ### Macaulay matrices with arbitrary rows and columns -/

section General

variable {σ ι : Type*}

/-- The polynomial `X^u * f i` of the row `r = (i, u)` of a Macaulay matrix. -/
def macaulayRowPoly {A : Type*} [CommRing A] (f : ι → MvPolynomial σ A) (r : ι × (σ →₀ ℕ)) :
    MvPolynomial σ A :=
  monomial r.2 1 * f r.1

/-- The Macaulay matrix of the polynomials `f` with rows `R` and columns `C`: the entry in the row
`r = (i, u)` and the column `v` is the coefficient of the monomial `v` in `X^u * f i`. -/
def macaulay {A : Type*} [CommRing A] (f : ι → MvPolynomial σ A) (R : Finset (ι × (σ →₀ ℕ)))
    (C : Finset (σ →₀ ℕ)) : Matrix R C A :=
  Matrix.of fun r c => (macaulayRowPoly f (r : ι × (σ →₀ ℕ))).coeff (c : σ →₀ ℕ)

theorem macaulay_apply {A : Type*} [CommRing A] (f : ι → MvPolynomial σ A) (R : Finset (ι × (σ →₀ ℕ)))
    (C : Finset (σ →₀ ℕ)) (r : R) (c : C) :
    macaulay f R C r c = (macaulayRowPoly f (r : ι × (σ →₀ ℕ))).coeff (c : σ →₀ ℕ) :=
  rfl

/-- Specializing the coefficients commutes with forming the Macaulay matrix. -/
theorem macaulay_map {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)
    (f : ι → MvPolynomial σ A) (R : Finset (ι × (σ →₀ ℕ))) (C : Finset (σ →₀ ℕ)) :
    macaulay (fun i => map φ (f i)) R C = (macaulay f R C).map φ := by
  ext r c
  simp only [macaulay_apply, Matrix.map_apply, macaulayRowPoly]
  rw [← coeff_map, map_mul, map_monomial, φ.map_one]

/-- The polynomial of a row lies in the ideal generated by the `f i`. -/
theorem macaulayRowPoly_mem_ideal {A : Type*} [CommRing A] (f : ι → MvPolynomial σ A)
    (r : ι × (σ →₀ ℕ)) : macaulayRowPoly f r ∈ Ideal.span (Set.range f) :=
  Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨r.1, rfl⟩)

/-- At a common zero of the `f i`, every element of the ideal they generate vanishes. -/
theorem eval_eq_zero_of_mem_ideal {K : Type*} [CommRing K] {f : ι → MvPolynomial σ K} {q : σ → K}
    (hq : ∀ i, eval q (f i) = 0) {p : MvPolynomial σ K} (hp : p ∈ Ideal.span (Set.range f)) :
    eval q p = 0 := by
  have hle : Ideal.span (Set.range f) ≤ RingHom.ker (eval q) := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact RingHom.mem_ker.mpr (hq i)
  exact RingHom.mem_ker.mp (hle hp)

variable [DecidableEq σ]

/-- The determinant of a square submatrix of rows of the Macaulay matrix commutes with specializations. -/
theorem map_det_macaulay_submatrix {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)
    (f : ι → MvPolynomial σ A) (R : Finset (ι × (σ →₀ ℕ))) (C : Finset (σ →₀ ℕ)) (S : C → R) :
    φ ((macaulay f R C).submatrix S id).det =
      ((macaulay (fun i => map φ (f i)) R C).submatrix S id).det := by
  rw [RingHom.map_det, RingHom.mapMatrix_apply, macaulay_map, Matrix.submatrix_map]

variable {K : Type*} [CommRing K]

/-- The core of the Macaulay argument. Let `S` choose a row `S c ∈ R` for every column `c ∈ C`, and suppose
that the polynomial of each chosen row only involves monomials of `C`. If the square matrix of the chosen rows is
invertible, every monomial of `C` is a linear combination of the polynomials of the chosen rows, with the entries
of the inverse matrix as coefficients. -/
theorem monomial_eq_sum_of_isUnit_det (f : ι → MvPolynomial σ K) {R : Finset (ι × (σ →₀ ℕ))}
    {C : Finset (σ →₀ ℕ)} (S : C → R)
    (hsupp : ∀ c : C, ∀ v ∈ (macaulayRowPoly f (S c : ι × (σ →₀ ℕ))).support, v ∈ C)
    (hdet : IsUnit ((macaulay f R C).submatrix S id).det) (c : C) :
    monomial (c : σ →₀ ℕ) (1 : K) =
      ∑ c' : C, ((macaulay f R C).submatrix S id)⁻¹ c c' •
        macaulayRowPoly f (S c' : ι × (σ →₀ ℕ)) := by
  set M := (macaulay f R C).submatrix S id with hM
  ext v
  rw [coeff_monomial, coeff_sum]
  simp only [coeff_smul, smul_eq_mul]
  by_cases hv : v ∈ C
  · have key : ∀ c' : C, (macaulayRowPoly f (S c' : ι × (σ →₀ ℕ))).coeff v = M c' ⟨v, hv⟩ :=
      fun c' => rfl
    simp only [key]
    rw [← Matrix.mul_apply, Matrix.nonsing_inv_mul M hdet, Matrix.one_apply]
    by_cases hcv : (c : σ →₀ ℕ) = v
    · have hc : c = ⟨v, hv⟩ := Subtype.ext hcv
      simp [hc]
    · have hc : c ≠ ⟨v, hv⟩ := fun h => hcv (congrArg Subtype.val h)
      simp [hcv, hc]
  · have h0 : ∀ c' : C, (macaulayRowPoly f (S c' : ι × (σ →₀ ℕ))).coeff v = 0 := by
      intro c'
      by_contra h
      exact hv (hsupp c' v (mem_support_iff.mpr h))
    have hcv : (c : σ →₀ ℕ) ≠ v := fun h => hv (h ▸ c.2)
    simp [h0, hcv]

/-- Under the hypotheses of `monomial_eq_sum_of_isUnit_det`, every monomial of `C` lies in the `K`-span of the
polynomials of the chosen rows. -/
theorem monomial_mem_span_of_isUnit_det (f : ι → MvPolynomial σ K) {R : Finset (ι × (σ →₀ ℕ))}
    {C : Finset (σ →₀ ℕ)} (S : C → R)
    (hsupp : ∀ c : C, ∀ v ∈ (macaulayRowPoly f (S c : ι × (σ →₀ ℕ))).support, v ∈ C)
    (hdet : IsUnit ((macaulay f R C).submatrix S id).det) (c : C) :
    monomial (c : σ →₀ ℕ) (1 : K) ∈
      Submodule.span K (Set.range fun c' : C => macaulayRowPoly f (S c' : ι × (σ →₀ ℕ))) := by
  rw [monomial_eq_sum_of_isUnit_det f S hsupp hdet c]
  exact Submodule.sum_mem _ fun c' _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨c', rfl⟩)

/-- Under the hypotheses of `monomial_eq_sum_of_isUnit_det`, every monomial of `C` lies in the ideal generated
by the `f i`. -/
theorem monomial_mem_ideal_of_isUnit_det (f : ι → MvPolynomial σ K) {R : Finset (ι × (σ →₀ ℕ))}
    {C : Finset (σ →₀ ℕ)} (S : C → R)
    (hsupp : ∀ c : C, ∀ v ∈ (macaulayRowPoly f (S c : ι × (σ →₀ ℕ))).support, v ∈ C)
    (hdet : IsUnit ((macaulay f R C).submatrix S id).det) (c : C) :
    monomial (c : σ →₀ ℕ) (1 : K) ∈ Ideal.span (Set.range f) := by
  rw [monomial_eq_sum_of_isUnit_det f S hsupp hdet c]
  exact Ideal.sum_mem _ fun c' _ =>
    Submodule.smul_of_tower_mem _ _ (macaulayRowPoly_mem_ideal f _)

end General

/-! ### Full column rank and maximal minors -/

section Rank

/-- Over a field, if the rows of a matrix span the whole space (full column rank), then some choice of as many
rows as there are columns gives a square matrix with nonzero determinant: a nonzero maximal minor. -/
theorem exists_submatrix_det_ne_zero {F m n : Type*} [Field F] [Fintype m] [Fintype n] [DecidableEq n]
    (M : Matrix m n F) (hM : Submodule.span F (Set.range M.row) = ⊤) :
    ∃ S : n → m, (M.submatrix S id).det ≠ 0 := by
  obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' F M.row
  have : Finite κ := Finite.of_injective a ha
  cases nonempty_fintype κ
  have hsp : ⊤ ≤ Submodule.span F (Set.range (M.row ∘ a)) := by rw [hspan, hM]
  have hcard : Fintype.card κ = Fintype.card n := by
    have := Module.finrank_eq_card_basis (Module.Basis.mk hli hsp)
    rw [Module.finrank_fintype_fun_eq_card] at this
    exact this.symm
  let eqv : κ ≃ n := Fintype.equivOfCardEq hcard
  refine ⟨a ∘ eqv.symm, ?_⟩
  have hli' : LinearIndependent F (M.submatrix (a ∘ eqv.symm) id).row :=
    hli.comp eqv.symm eqv.symm.injective
  rw [Matrix.linearIndependent_rows_iff_isUnit, Matrix.isUnit_iff_isUnit_det] at hli'
  exact hli'.ne_zero

/-- Full column rank in terms of `Matrix.rank`: the rows span the whole space. -/
theorem span_row_eq_top_of_rank_eq {F m n : Type*} [Field F] [Fintype m] [Fintype n]
    (M : Matrix m n F) (h : M.rank = Fintype.card n) : Submodule.span F (Set.range M.row) = ⊤ := by
  apply Submodule.eq_top_of_finrank_eq
  rw [← Matrix.rank_eq_finrank_span_row, h, Module.finrank_fintype_fun_eq_card]

/-- A certificate for a nonzero determinant: if the image of a square matrix `M` under a ring map `φ` into a
nontrivial ring (for example `ZMod p`, with `p > 1`) has a right inverse `W`, then `φ (det M) ≠ 0`; in
particular `det M ≠ 0` (`det_ne_zero_of_map_mul_eq_one'`). -/
theorem det_ne_zero_of_map_mul_eq_one {B T : Type*} [CommRing B] [CommRing T] [Nontrivial T]
    (φ : B →+* T) {n : Type*} [Fintype n] [DecidableEq n] {M : Matrix n n B} {W : Matrix n n T}
    (hW : M.map φ * W = 1) : φ M.det ≠ 0 := by
  rw [RingHom.map_det, RingHom.mapMatrix_apply]
  exact Matrix.det_ne_zero_of_right_inverse hW

/-- The certificate of `det_ne_zero_of_map_mul_eq_one` shows `det M ≠ 0` in the coefficient ring. -/
theorem det_ne_zero_of_map_mul_eq_one' {B T : Type*} [CommRing B] [CommRing T] [Nontrivial T]
    (φ : B →+* T) {n : Type*} [Fintype n] [DecidableEq n] {M : Matrix n n B} {W : Matrix n n T}
    (hW : M.map φ * W = 1) : M.det ≠ 0 := fun h =>
  det_ne_zero_of_map_mul_eq_one φ hW (by rw [h, map_zero])

/-- The certificate of item (c) with values in `ZMod p`. -/
theorem det_ne_zero_of_map_zmod_mul_eq_one {B : Type*} [CommRing B] {p : ℕ} [Fact (1 < p)]
    (φ : B →+* ZMod p) {n : Type*} [Fintype n] [DecidableEq n] {M : Matrix n n B}
    {W : Matrix n n (ZMod p)} (hW : M.map φ * W = 1) : φ M.det ≠ 0 ∧ M.det ≠ 0 :=
  ⟨det_ne_zero_of_map_mul_eq_one φ hW, det_ne_zero_of_map_mul_eq_one' φ hW⟩

end Rank

/-! ### The homogeneous case: the Macaulay matrix in degree `D` -/

section Homogeneous

variable {σ ι : Type*} [Fintype σ] [DecidableEq σ] [Fintype ι]

/-- The monomials of degree `D` in the variables `σ` (the columns of the Macaulay matrix in degree `D`). -/
def monomialsOfDegree (σ : Type*) [Fintype σ] [DecidableEq σ] (D : ℕ) : Finset (σ →₀ ℕ) :=
  Finset.finsuppAntidiag Finset.univ D

@[simp] theorem mem_monomialsOfDegree {D : ℕ} {v : σ →₀ ℕ} :
    v ∈ monomialsOfDegree σ D ↔ v.degree = D := by
  simp [monomialsOfDegree, Finsupp.degree_eq_sum]

/-- The monomials of degree at most `D`. -/
def monomialsUpTo (σ : Type*) [Fintype σ] [DecidableEq σ] (D : ℕ) : Finset (σ →₀ ℕ) :=
  (Finset.range (D + 1)).biUnion (monomialsOfDegree σ)

@[simp] theorem mem_monomialsUpTo {D : ℕ} {v : σ →₀ ℕ} : v ∈ monomialsUpTo σ D ↔ v.degree ≤ D := by
  simp [monomialsUpTo]

/-- The rows of the Macaulay matrix in degree `D` of forms of degrees `d i`: the pairs `(i, u)` with `u` a
monomial of degree `D - d i` (and `d i ≤ D`). -/
def macaulayRows (σ : Type*) [Fintype σ] [DecidableEq σ] (d : ι → ℕ) (D : ℕ) :
    Finset (ι × (σ →₀ ℕ)) :=
  (Finset.univ ×ˢ monomialsUpTo σ D).filter fun r => d r.1 + r.2.degree = D

@[simp] theorem mem_macaulayRows {d : ι → ℕ} {D : ℕ} {r : ι × (σ →₀ ℕ)} :
    r ∈ macaulayRows σ d D ↔ d r.1 + r.2.degree = D := by
  simp only [macaulayRows, Finset.mem_filter, Finset.mem_product, Finset.mem_univ, true_and,
    mem_monomialsUpTo, and_iff_right_iff_imp]
  intro h
  omega

/-- The Macaulay matrix in degree `D` of the forms `f i` of degrees `d i`: rows `(i, u)` with `deg u = D - d i`,
columns the monomials `v` of degree `D`, entries `coeff_v (X^u f_i)`. -/
def macaulayMatrix {A : Type*} [CommRing A] (f : ι → MvPolynomial σ A) (d : ι → ℕ) (D : ℕ) :
    Matrix (macaulayRows σ d D) (monomialsOfDegree σ D) A :=
  macaulay f (macaulayRows σ d D) (monomialsOfDegree σ D)

/-- The maximal minor of the Macaulay matrix in degree `D` with rows chosen by `S`: the determinant of the square
matrix whose row `c` is the row `S c`. If the coefficient ring is `R[μ]`, it is a polynomial in the parameters. -/
def macaulayMinor {A : Type*} [CommRing A] (f : ι → MvPolynomial σ A) (d : ι → ℕ) (D : ℕ)
    (S : monomialsOfDegree σ D → macaulayRows σ d D) : A :=
  ((macaulayMatrix f d D).submatrix S id).det

/-- The maximal minor of the specialized forms is the specialization of the maximal minor. -/
theorem map_macaulayMinor {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)
    (f : ι → MvPolynomial σ A) (d : ι → ℕ) (D : ℕ) (S : monomialsOfDegree σ D → macaulayRows σ d D) :
    φ (macaulayMinor f d D S) = macaulayMinor (fun i => map φ (f i)) d D S :=
  map_det_macaulay_submatrix φ f _ _ S

/-- Reindexing, for certificates computed with matrices indexed by `Fin k`: if `e` enumerates the monomials of
degree `D` and `g` chooses the rows, the maximal minor with rows `g ∘ e.symm` is the determinant of the matrix
with entries `M (g a) (e b)`. -/
theorem macaulayMinor_reindex {A : Type*} [CommRing A] (f : ι → MvPolynomial σ A) (d : ι → ℕ) (D : ℕ)
    {n : Type*} [Fintype n] [DecidableEq n] (e : n ≃ monomialsOfDegree σ D)
    (g : n → macaulayRows σ d D) :
    macaulayMinor f d D (g ∘ e.symm) = ((macaulayMatrix f d D).submatrix g e).det := by
  rw [macaulayMinor, ← Matrix.det_submatrix_equiv_self e, Matrix.submatrix_submatrix]
  congr 2
  funext a
  simp

/-- For forms of degrees `d i`, the polynomial `X^u f_i` of a row in degree `D` only involves monomials of
degree `D`. -/
theorem macaulayRowPoly_mem_monomialsOfDegree {A : Type*} [CommRing A] {f : ι → MvPolynomial σ A}
    {d : ι → ℕ} (hf : ∀ i, (f i).IsHomogeneous (d i)) {D : ℕ} (r : macaulayRows σ d D) :
    ∀ v ∈ (macaulayRowPoly f (r : ι × (σ →₀ ℕ))).support, v ∈ monomialsOfDegree σ D := by
  intro v hv
  have hr := mem_macaulayRows.mp r.2
  have hhom : (macaulayRowPoly f (r : ι × (σ →₀ ℕ))).IsHomogeneous D := by
    have := (isHomogeneous_monomial (1 : A) (rfl : (r : ι × (σ →₀ ℕ)).2.degree = _)).mul
      (hf (r : ι × (σ →₀ ℕ)).1)
    rw [add_comm, hr] at this
    exact this
  rw [mem_monomialsOfDegree]
  by_contra hne
  exact (mem_support_iff.mp hv) (hhom.coeff_eq_zero hne)

variable {K : Type*} [Field K]

/-- Item (a), linear algebra: if the maximal minor with rows `S` is nonzero, every monomial of degree `D` is a
`K`-linear combination of the polynomials `X^u f_i` with `(i, u)` among the rows `S`. -/
theorem monomial_mem_span_of_macaulayMinor_ne_zero (f : ι → MvPolynomial σ K) {d : ι → ℕ}
    (hf : ∀ i, (f i).IsHomogeneous (d i)) {D : ℕ} (S : monomialsOfDegree σ D → macaulayRows σ d D)
    (hS : macaulayMinor f d D S ≠ 0) {v : σ →₀ ℕ} (hv : v.degree = D) :
    monomial v (1 : K) ∈
      Submodule.span K (Set.range fun c => macaulayRowPoly f (S c : ι × (σ →₀ ℕ))) :=
  monomial_mem_span_of_isUnit_det f S (fun c => macaulayRowPoly_mem_monomialsOfDegree hf (S c))
    (isUnit_iff_ne_zero.mpr hS) ⟨v, mem_monomialsOfDegree.mpr hv⟩

/-- Item (a): if the maximal minor with rows `S` is nonzero, every monomial of degree `D` lies in the ideal of
the forms. -/
theorem monomial_mem_ideal_of_macaulayMinor_ne_zero (f : ι → MvPolynomial σ K) {d : ι → ℕ}
    (hf : ∀ i, (f i).IsHomogeneous (d i)) {D : ℕ} (S : monomialsOfDegree σ D → macaulayRows σ d D)
    (hS : macaulayMinor f d D S ≠ 0) {v : σ →₀ ℕ} (hv : v.degree = D) :
    monomial v (1 : K) ∈ Ideal.span (Set.range f) :=
  monomial_mem_ideal_of_isUnit_det f S (fun c => macaulayRowPoly_mem_monomialsOfDegree hf (S c))
    (isUnit_iff_ne_zero.mpr hS) ⟨v, mem_monomialsOfDegree.mpr hv⟩

/-- Item (a): if a maximal minor of the Macaulay matrix in degree `D` is nonzero, the forms have no common zero
`q ≠ 0`: if `q_k ≠ 0` then the monomial `q_k^D` of degree `D` would vanish at `q`. -/
theorem eq_zero_of_macaulayMinor_ne_zero (f : ι → MvPolynomial σ K) {d : ι → ℕ}
    (hf : ∀ i, (f i).IsHomogeneous (d i)) {D : ℕ} (S : monomialsOfDegree σ D → macaulayRows σ d D)
    (hS : macaulayMinor f d D S ≠ 0) (q : σ → K) (hq : ∀ i, eval q (f i) = 0) : q = 0 := by
  funext k
  have hmem := monomial_mem_ideal_of_macaulayMinor_ne_zero f hf S hS (Finsupp.degree_single k D)
  have h := eval_eq_zero_of_mem_ideal hq hmem
  rw [← X_pow_eq_monomial, eval_pow, eval_X] at h
  exact eq_zero_of_pow_eq_zero h

/-- Item (a) at a parameter point: if the specialization `φ h` of the maximal minor `h = det M_S` is nonzero,
every monomial of degree `D` is a `K`-linear combination of the specialized polynomials `X^u f_i` with
`(i, u)` among the rows `S`. -/
theorem monomial_mem_span_of_map_macaulayMinor_ne_zero {A : Type*} [CommRing A] (φ : A →+* K)
    (f : ι → MvPolynomial σ A) {d : ι → ℕ} (hf : ∀ i, (f i).IsHomogeneous (d i)) {D : ℕ}
    (S : monomialsOfDegree σ D → macaulayRows σ d D) (hS : φ (macaulayMinor f d D S) ≠ 0)
    {v : σ →₀ ℕ} (hv : v.degree = D) :
    monomial v (1 : K) ∈ Submodule.span K
      (Set.range fun c => macaulayRowPoly (fun i => map φ (f i)) (S c : ι × (σ →₀ ℕ))) := by
  rw [map_macaulayMinor] at hS
  exact monomial_mem_span_of_macaulayMinor_ne_zero _ (fun i => (hf i).map φ) S hS hv

/-- Item (b): let `φ : A →+* K` specialize the coefficients (evaluation at a parameter point). If the
specialization of the maximal minor `h = det M_S` is nonzero, the specialized forms have no common zero `q ≠ 0`. -/
theorem eq_zero_of_map_macaulayMinor_ne_zero {A : Type*} [CommRing A] (φ : A →+* K)
    (f : ι → MvPolynomial σ A) {d : ι → ℕ} (hf : ∀ i, (f i).IsHomogeneous (d i)) {D : ℕ}
    (S : monomialsOfDegree σ D → macaulayRows σ d D) (hS : φ (macaulayMinor f d D S) ≠ 0)
    (q : σ → K) (hq : ∀ i, eval q (map φ (f i)) = 0) : q = 0 := by
  rw [map_macaulayMinor] at hS
  exact eq_zero_of_macaulayMinor_ne_zero (fun i => map φ (f i)) (fun i => (hf i).map φ) S hS q hq

/-- Item (b), the transfer, for coefficients that are polynomials in parameters `μ ∈ K^τ` over a ring `R`
(with `ψ : R →+* K`; for `R = ℤ` the evaluation `eval₂ ψ μ` is `aeval μ`). The maximal minor `h` is a polynomial
in `μ`. If `h(μ₀) ≠ 0` at one point, then `h ≠ 0`, and for every `μ` off the hypersurface `h = 0` the forms
specialized at `μ` have no common zero `q ≠ 0`. -/
theorem macaulay_transfer {τ R : Type*} [CommRing R] (ψ : R →+* K)
    (f : ι → MvPolynomial σ (MvPolynomial τ R)) {d : ι → ℕ} (hf : ∀ i, (f i).IsHomogeneous (d i))
    {D : ℕ} (S : monomialsOfDegree σ D → macaulayRows σ d D) {μ₀ : τ → K}
    (h₀ : eval₂ ψ μ₀ (macaulayMinor f d D S) ≠ 0) :
    macaulayMinor f d D S ≠ 0 ∧
      ∀ μ : τ → K, eval₂ ψ μ (macaulayMinor f d D S) ≠ 0 →
        ∀ q : σ → K, (∀ i, eval q (map (eval₂Hom ψ μ) (f i)) = 0) → q = 0 := by
  refine ⟨fun h => h₀ (by rw [h, eval₂_zero]), fun μ hμ q hq => ?_⟩
  rw [← coe_eval₂Hom] at hμ
  exact eq_zero_of_map_macaulayMinor_ne_zero (eval₂Hom ψ μ) f hf S hμ q hq

/-- Item (c), constant coefficients: the coefficient ring `B` (for example `ℤ[j]`) has an injective ring map
`ψ` into the field `K` (for example `ℂ`) and a ring map `φ` into a nontrivial ring `T` (for example
`ZMod p`). If `φ(M_S) · W = 1` for some matrix `W` over `T`, the forms, mapped to `K` by `ψ`, have no common zero
`q ≠ 0`. -/
theorem eq_zero_of_macaulay_certificate {B T : Type*} [CommRing B] [CommRing T] [Nontrivial T]
    (ψ : B →+* K) (hψ : Function.Injective ψ) (φ : B →+* T) (f : ι → MvPolynomial σ B) {d : ι → ℕ}
    (hf : ∀ i, (f i).IsHomogeneous (d i)) {D : ℕ} (S : monomialsOfDegree σ D → macaulayRows σ d D)
    (W : Matrix (monomialsOfDegree σ D) (monomialsOfDegree σ D) T)
    (hW : ((macaulayMatrix f d D).submatrix S id).map φ * W = 1) (q : σ → K)
    (hq : ∀ i, eval q (map ψ (f i)) = 0) : q = 0 := by
  have h2 : macaulayMinor f d D S ≠ 0 := det_ne_zero_of_map_mul_eq_one' φ hW
  exact eq_zero_of_map_macaulayMinor_ne_zero ψ f hf S ((map_ne_zero_iff ψ hψ).mpr h2) q hq

/-- Items (b) and (c) together, for coefficients that are polynomials in parameters over `B`: a certificate at
the point `μ₀ ∈ B^τ` (a ring map `φ : B →+* T` into a nontrivial ring and `W` with `φ(M_S(μ₀)) · W = 1`) shows
that the maximal minor `h ∈ B[μ]` is nonzero, nonzero at `μ₀` (mapped to `K`), and that off the hypersurface
`h = 0` in `K^τ` the forms have no common zero `q ≠ 0`. -/
theorem macaulay_transfer_certificate {τ B T : Type*} [CommRing B] [CommRing T] [Nontrivial T]
    (ψ : B →+* K) (hψ : Function.Injective ψ) (φ : B →+* T)
    (f : ι → MvPolynomial σ (MvPolynomial τ B)) {d : ι → ℕ} (hf : ∀ i, (f i).IsHomogeneous (d i))
    {D : ℕ} (S : monomialsOfDegree σ D → macaulayRows σ d D) (μ₀ : τ → B)
    (W : Matrix (monomialsOfDegree σ D) (monomialsOfDegree σ D) T)
    (hW : ((macaulayMatrix f d D).submatrix S id).map (φ.comp (eval μ₀)) * W = 1) :
    macaulayMinor f d D S ≠ 0 ∧ eval₂ ψ (ψ ∘ μ₀) (macaulayMinor f d D S) ≠ 0 ∧
      ∀ μ : τ → K, eval₂ ψ μ (macaulayMinor f d D S) ≠ 0 →
        ∀ q : σ → K, (∀ i, eval q (map (eval₂Hom ψ μ) (f i)) = 0) → q = 0 := by
  have h1 : (φ.comp (eval μ₀)) (macaulayMinor f d D S) ≠ 0 := det_ne_zero_of_map_mul_eq_one _ hW
  have h2 : eval μ₀ (macaulayMinor f d D S) ≠ 0 := fun h => h1 (by
    rw [RingHom.comp_apply, h, map_zero])
  have h3 : eval₂ ψ (ψ ∘ μ₀) (macaulayMinor f d D S) ≠ 0 := by
    have := eval₂_comp_left ψ (RingHom.id B) μ₀ (macaulayMinor f d D S)
    rw [RingHom.comp_id, eval₂_id] at this
    rw [← this]
    exact (map_ne_zero_iff ψ hψ).mpr h2
  exact ⟨(macaulay_transfer ψ f hf S h3).1, h3, (macaulay_transfer ψ f hf S h3).2⟩

/-- `macaulay_transfer_certificate` for a certificate indexed by any type `n` (for example `Fin k`): `e`
enumerates the monomials of degree `D`, `g` chooses the rows, and `W` is a right inverse of the matrix with
entries `φ (M (g a) (e b))(μ₀)`. The maximal minor is the one with rows `g ∘ e.symm`. -/
theorem macaulay_transfer_certificate_reindex {τ B T : Type*} [CommRing B] [CommRing T] [Nontrivial T]
    (ψ : B →+* K) (hψ : Function.Injective ψ) (φ : B →+* T)
    (f : ι → MvPolynomial σ (MvPolynomial τ B)) {d : ι → ℕ} (hf : ∀ i, (f i).IsHomogeneous (d i))
    {D : ℕ} {n : Type*} [Fintype n] [DecidableEq n] (e : n ≃ monomialsOfDegree σ D)
    (g : n → macaulayRows σ d D) (μ₀ : τ → B) (W : Matrix n n T)
    (hW : ((macaulayMatrix f d D).submatrix g e).map (φ.comp (eval μ₀)) * W = 1) :
    macaulayMinor f d D (g ∘ e.symm) ≠ 0 ∧ eval₂ ψ (ψ ∘ μ₀) (macaulayMinor f d D (g ∘ e.symm)) ≠ 0 ∧
      ∀ μ : τ → K, eval₂ ψ μ (macaulayMinor f d D (g ∘ e.symm)) ≠ 0 →
        ∀ q : σ → K, (∀ i, eval q (map (eval₂Hom ψ μ) (f i)) = 0) → q = 0 := by
  have h1 : (φ.comp (eval μ₀)) (macaulayMinor f d D (g ∘ e.symm)) ≠ 0 := by
    rw [macaulayMinor_reindex]
    exact det_ne_zero_of_map_mul_eq_one _ hW
  have h2 : eval μ₀ (macaulayMinor f d D (g ∘ e.symm)) ≠ 0 := fun h => h1 (by
    rw [RingHom.comp_apply, h, map_zero])
  have h3 : eval₂ ψ (ψ ∘ μ₀) (macaulayMinor f d D (g ∘ e.symm)) ≠ 0 := by
    have := eval₂_comp_left ψ (RingHom.id B) μ₀ (macaulayMinor f d D (g ∘ e.symm))
    rw [RingHom.comp_id, eval₂_id] at this
    rw [← this]
    exact (map_ne_zero_iff ψ hψ).mpr h2
  exact ⟨(macaulay_transfer ψ f hf _ h3).1, h3, (macaulay_transfer ψ f hf _ h3).2⟩

/-- Full column rank as a certificate: if the Macaulay matrix in degree `D`, specialized by `φ` into a field
`F`, has rank equal to the number of monomials of degree `D`, then some maximal minor `h` has `φ h ≠ 0`. -/
theorem exists_macaulayMinor_ne_zero_of_rank {A F : Type*} [CommRing A] [Field F] (φ : A →+* F)
    (f : ι → MvPolynomial σ A) (d : ι → ℕ) (D : ℕ)
    (h : ((macaulayMatrix f d D).map φ).rank = Fintype.card (monomialsOfDegree σ D)) :
    ∃ S : monomialsOfDegree σ D → macaulayRows σ d D, φ (macaulayMinor f d D S) ≠ 0 := by
  obtain ⟨S, hS⟩ := exists_submatrix_det_ne_zero _ (span_row_eq_top_of_rank_eq _ h)
  refine ⟨S, ?_⟩
  rw [macaulayMinor, RingHom.map_det, RingHom.mapMatrix_apply, ← Matrix.submatrix_map]
  exact hS

end Homogeneous

