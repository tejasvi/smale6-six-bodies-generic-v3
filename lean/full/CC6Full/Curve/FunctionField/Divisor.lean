import CC6Full.Curve.FunctionField.Degree
import CC6Full.Curve.FunctionField.Residue
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental

/-!
# Divisors of functions on a curve

For an irreducible curve `C ⊆ ℂ^σ` (`σ` finite) with function field `K = ℂ(C)`:

* `const_or_transcendental`: a function is a constant or transcendental over `ℂ` (`ℂ` is algebraically closed).
* `trdeg_eq_one`: `K` has transcendence degree one over `ℂ` (the Noether parameter `t₀` is a transcendence basis,
  every function being algebraic over `ℂ[t₀]`, `algRel_of_curve`).
* `finiteDimensional_of_transcendental`: for every transcendental `g ∈ K`, `K` is finite over `ℂ⟮g⟯` (`{g}` is a
  transcendence basis, and `K` is generated by the finitely many coordinate functions, `adjoin_coords_eq_top`).
* `place_ord_injective`, `placeOfNorm`: places are the normalized discrete valuations of `K` trivial on `ℂ`.
* `degree_zero`: a transcendental `g` has finitely many places with `ord g ≠ 0`, and `Σ_P ord_P g = 0`
  (`degree_pos_places` for `g` and `g⁻¹`).
* `exists_pole`: a transcendental `g` has a pole.

Ported from the five-body formalization (`CC5Full/Theory/FunctionField/Divisor.lean`), with the curves `C ⊆ Y_m`
replaced by the affine curves `ACurve σ`. The balancing statements of that file, which concern the five-body
variety, are not part of this port.
-/

open IntermediateField

namespace CC6Full

open MvPolynomial

noncomputable section

variable {σ : Type*} {C : ACurve σ}

/-- A function on a curve is a constant or transcendental over `ℂ`. -/
theorem const_or_transcendental (f : C.FunctionField) :
    (∃ c : ℂ, f = algebraMap ℂ C.FunctionField c) ∨ Transcendental ℂ f := by
  by_cases h : IsAlgebraic ℂ f
  · left
    have : Algebra.IsAlgebraic ℂ ℂ⟮f⟯ := isAlgebraic_adjoin_simple h.isIntegral
    have hbot := IntermediateField.eq_bot_of_isAlgClosed_of_isAlgebraic ℂ⟮f⟯
    have hf : f ∈ ℂ⟮f⟯ := IntermediateField.mem_adjoin_simple_self ℂ f
    rw [hbot, IntermediateField.mem_bot] at hf
    obtain ⟨c, hc⟩ := hf
    exact ⟨c, hc.symm⟩
  · right; exact h

/-- **`ℂ(C)` has transcendence degree one.** -/
theorem trdeg_eq_one [Finite σ] (C : ACurve σ) : Algebra.trdeg ℂ C.FunctionField = 1 := by
  obtain ⟨t₀, hinj, hint⟩ := curve_noether C
  set t := algebraMap C.Ring C.FunctionField t₀
  have ht : Transcendental ℂ t := by
    rw [transcendental_iff_injective]
    have h1 : (Polynomial.aeval t : Polynomial ℂ →ₐ[ℂ] C.FunctionField) =
        (IsScalarTower.toAlgHom ℂ C.Ring C.FunctionField).comp (Polynomial.aeval t₀) := by
      ext; simp [t]
    rw [h1, AlgHom.coe_comp]
    exact (IsFractionRing.injective C.Ring C.FunctionField).comp hinj
  have hind : AlgebraicIndependent ℂ (fun _ : Unit => t) := algebraicIndependent_unique_type_iff.mpr ht
  have hrange : Set.range (fun _ : Unit => t) = {t} := Set.range_const
  have halg : Algebra.IsAlgebraic (Algebra.adjoin ℂ (Set.range fun _ : Unit => t)) C.FunctionField := by
    rw [hrange]
    refine ⟨fun f => ?_⟩
    obtain ⟨Q, hQ, hQf⟩ := algRel_of_curve hinj hint f
    set e := Polynomial.algEquivOfTranscendental ℂ t ht
    refine ⟨Q.map e.toRingHom, (Polynomial.map_ne_zero_iff e.injective).mpr hQ, ?_⟩
    have hcomp : (algebraMap (Algebra.adjoin ℂ {t}) C.FunctionField).comp e.toRingHom =
        (Polynomial.aeval t).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro a
        have h1 : e (Polynomial.C a) = algebraMap ℂ (Algebra.adjoin ℂ {t}) a := by
          rw [← e.commutes a, Polynomial.algebraMap_eq]
        simp [h1]
      · simp [e]
    rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp]
    exact hQf
  have hbasis := (hind.isTranscendenceBasis_iff_isAlgebraic).mpr halg
  have h := hbasis.lift_cardinalMk_eq_trdeg
  rw [Cardinal.lift_uzero] at h
  rw [← h, Cardinal.mk_fintype, Fintype.card_unit, Nat.cast_one, Cardinal.lift_one]

/-- `ℂ(C)` is generated by the coordinate functions over any intermediate field. -/
theorem adjoin_coords_eq_top (F : IntermediateField ℂ C.FunctionField) :
    IntermediateField.adjoin F (Set.range fun c : σ => C.fn (X c)) = ⊤ := by
  rw [eq_top_iff]
  intro f _
  set A := IntermediateField.adjoin F (Set.range fun c : σ => C.fn (X c))
  have hpoly : ∀ p : MvPolynomial σ ℂ, C.fn p ∈ A := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [fn_C_eq_algebraMap, IsScalarTower.algebraMap_apply ℂ F C.FunctionField]
      exact A.algebraMap_mem _
    | add p q hp hq =>
      rw [show C.fn (p + q) = C.fn p + C.fn q by set_option synthInstance.maxHeartbeats 400000 in simp only [ACurve.fn, map_add]]
      exact A.add_mem hp hq
    | mul_X p c hp =>
      rw [show C.fn (p * X c) = C.fn p * C.fn (X c) by simp only [ACurve.fn, map_mul]]
      exact A.mul_mem hp (IntermediateField.subset_adjoin _ _ ⟨c, rfl⟩)
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := C.Ring) f
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective b
  exact A.div_mem (hpoly p) (hpoly q)

/-- **`ℂ(C)` is finite over `ℂ⟮g⟯` for every transcendental `g`.** -/
theorem finiteDimensional_of_transcendental [Finite σ] {g : C.FunctionField} (hg : Transcendental ℂ g) :
    FiniteDimensional ℂ⟮g⟯ C.FunctionField := by
  have hind : AlgebraicIndependent ℂ (fun _ : Unit => g) := algebraicIndependent_unique_type_iff.mpr hg
  have hbasis : IsTranscendenceBasis ℂ (fun _ : Unit => g) :=
    hind.isTranscendenceBasis_of_lift_trdeg_le_of_finite (by
      rw [Cardinal.lift_uzero, trdeg_eq_one C, Cardinal.mk_fintype, Fintype.card_unit, Nat.cast_one,
        Cardinal.lift_one])
  have halg := hbasis.isAlgebraic_field
  have hrange : Set.range (fun _ : Unit => g) = {g} := Set.range_const
  rw [hrange] at halg
  have hfin := IntermediateField.finiteDimensional_adjoin (K := ℂ⟮g⟯)
    (S := Set.range fun c : σ => C.fn (X c)) (fun s _ => (halg.isAlgebraic s).isIntegral)
  rw [adjoin_coords_eq_top] at hfin
  exact (IntermediateField.topEquiv (F := ℂ⟮g⟯) (E := C.FunctionField)).toLinearEquiv.finiteDimensional

/-! ## Places and normalized valuations -/

theorem isNormPlace_ord (P : Place C) : IsNormPlace P.ord :=
  ⟨fun c hc => ord_algebraMap P c hc, P.exists_ord_eq_one⟩

/-- A normalized valuation trivial on `ℂ` as a place. -/
def placeOfNorm (w : AddValuation C.FunctionField (WithTop ℤ)) (hw : IsNormPlace w) : Place C :=
  ⟨w, fun c hc => by rw [fn_C_eq_algebraMap]; exact hw.const c hc, hw.one⟩

theorem place_ord_injective : Function.Injective (fun P : Place C => P.ord) := by
  intro P Q h
  cases P
  cases Q
  simp only at h
  subst h
  rfl

theorem transcendental_inv {g : C.FunctionField} (hg : Transcendental ℂ g) : Transcendental ℂ g⁻¹ :=
  fun h => hg (IsAlgebraic.inv_iff.mp h)

theorem ne_zero_of_transcendental {g : C.FunctionField} (hg : Transcendental ℂ g) : g ≠ 0 :=
  fun h => hg (h ▸ isAlgebraic_zero)

/-- **Degree zero**: a transcendental function has finitely many places with `ord ≠ 0`, and its orders sum to
`0`. -/
theorem degree_zero [Finite σ] {g : C.FunctionField} (hg : Transcendental ℂ g) :
    ∃ S : Finset (Place C), (∀ P, P ∈ S ↔ P.ord g ≠ 0) ∧ ∑ P ∈ S, ordZ P.ord g = 0 := by
  classical
  have hg0 := ne_zero_of_transcendental hg
  have hginv := transcendental_inv hg
  have := finiteDimensional_of_transcendental hg
  have := finiteDimensional_of_transcendental hginv
  have hadj : ℂ⟮g⁻¹⟯ = ℂ⟮g⟯ := le_antisymm
    (adjoin_simple_le_iff.mpr (inv_mem (mem_adjoin_simple_self ℂ g)))
    (adjoin_simple_le_iff.mpr (by simpa using inv_mem (mem_adjoin_simple_self ℂ g⁻¹)))
  have hn : Module.finrank ℂ⟮g⁻¹⟯ C.FunctionField = Module.finrank ℂ⟮g⟯ C.FunctionField := by
    rw [hadj]
  obtain ⟨S1, hS1, hsum1⟩ := degree_pos_places g hg
  obtain ⟨S2, hS2, hsum2⟩ := degree_pos_places g⁻¹ hginv
  rw [hn] at hsum2
  set n := Module.finrank ℂ⟮g⟯ C.FunctionField
  have hspec : ∀ w : AddValuation C.FunctionField (WithTop ℤ), w g = (ordZ w g : WithTop ℤ) :=
    fun w => ordZ_spec w hg0
  have hspec' : ∀ w : AddValuation C.FunctionField (WithTop ℤ), w g⁻¹ = (-ordZ w g : ℤ) := by
    intro w
    rw [ordZ_spec w (inv_ne_zero hg0), ordZ_inv w hg0]
  have hsum1' : ∑ w ∈ S1, ordZ w g = n := by
    have h1 : ((∑ w ∈ S1, ordZ w g : ℤ) : WithTop ℤ) = ((n : ℤ) : WithTop ℤ) := by
      rw [WithTop.coe_sum]
      simp only [← hspec]
      rw [hsum1]
      rfl
    exact_mod_cast h1
  have hsum2' : ∑ w ∈ S2, ordZ w g = -n := by
    have h1 : ((∑ w ∈ S2, -ordZ w g : ℤ) : WithTop ℤ) = ((n : ℤ) : WithTop ℤ) := by
      rw [WithTop.coe_sum]
      simp only [← hspec']
      rw [hsum2]
      rfl
    have h2 : ∑ w ∈ S2, -ordZ w g = n := by exact_mod_cast h1
    rw [Finset.sum_neg_distrib] at h2
    linarith
  have hpos1 : ∀ w ∈ S1, 0 < ordZ w g := fun w hw => by
    have h1 := ((hS1 w).mp hw).2
    rw [hspec] at h1
    exact_mod_cast h1
  have hneg2 : ∀ w ∈ S2, ordZ w g < 0 := fun w hw => by
    have h1 := ((hS2 w).mp hw).2
    rw [hspec'] at h1
    have h2 : (0 : ℤ) < -ordZ w g := by exact_mod_cast h1
    linarith
  have hdisj : Disjoint S1 S2 := by
    rw [Finset.disjoint_left]
    intro w h1 h2
    have := hpos1 w h1
    have := hneg2 w h2
    omega
  have hmem : ∀ w, w ∈ S1 ∪ S2 ↔ IsNormPlace w ∧ w g ≠ 0 := by
    intro w
    rw [Finset.mem_union, hS1, hS2, hspec, hspec']
    constructor
    · rintro (⟨hw, h⟩ | ⟨hw, h⟩)
      · exact ⟨hw, ne_of_gt h⟩
      · refine ⟨hw, fun h0 => ?_⟩
        have h3 : ordZ w g = 0 := by exact_mod_cast h0
        rw [h3, neg_zero] at h
        exact lt_irrefl _ h
    · rintro ⟨hw, h⟩
      have h3 : ordZ w g ≠ 0 := fun h0 => h (by rw [h0]; rfl)
      rcases lt_or_gt_of_ne h3 with h4 | h4
      · right; refine ⟨hw, ?_⟩
        have : (0 : ℤ) < -ordZ w g := by linarith
        exact_mod_cast this
      · left; exact ⟨hw, by exact_mod_cast h4⟩
  have hinjOn : Set.InjOn (fun P : Place C => P.ord) ((fun P : Place C => P.ord) ⁻¹' ↑(S1 ∪ S2)) :=
    fun P _ Q _ h => place_ord_injective h
  refine ⟨(S1 ∪ S2).preimage (fun P : Place C => P.ord) hinjOn, fun P => ?_, ?_⟩
  · rw [Finset.mem_preimage, hmem]
    exact ⟨fun h => h.2, fun h => ⟨isNormPlace_ord P, h⟩⟩
  · have h1 := Finset.sum_preimage (fun P : Place C => P.ord) (S1 ∪ S2) hinjOn (fun w => ordZ w g) (by
      intro w hw hnot
      exact absurd ⟨placeOfNorm w ((hmem w).mp hw).1, rfl⟩ hnot)
    rw [h1, Finset.sum_union hdisj, hsum1', hsum2']
    ring

/-- **A transcendental function has a pole.** -/
theorem exists_pole [Finite σ] {g : C.FunctionField} (hg : Transcendental ℂ g) : ∃ P : Place C, P.ord g < 0 := by
  classical
  have hg0 := ne_zero_of_transcendental hg
  have hginv := transcendental_inv hg
  have := finiteDimensional_of_transcendental hginv
  obtain ⟨S2, hS2, hsum2⟩ := degree_pos_places g⁻¹ hginv
  have hpos : 0 < Module.finrank ℂ⟮g⁻¹⟯ C.FunctionField := Module.finrank_pos
  obtain ⟨w, hw⟩ : S2.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    rintro rfl
    rw [Finset.sum_empty] at hsum2
    have : ((0 : ℕ) : WithTop ℤ) = (Module.finrank ℂ⟮g⁻¹⟯ C.FunctionField : WithTop ℤ) := by
      rw [Nat.cast_zero]; exact hsum2
    have := Nat.cast_injective (R := WithTop ℤ) this
    omega
  obtain ⟨hwn, hwpos⟩ := (hS2 w).mp hw
  refine ⟨placeOfNorm w hwn, ?_⟩
  show w g < 0
  rw [ordZ_spec w (inv_ne_zero hg0), ordZ_inv w hg0] at hwpos
  rw [ordZ_spec w hg0]
  have h1 : (0 : ℤ) < -ordZ w g := by exact_mod_cast hwpos
  have h2 : ordZ w g < 0 := by linarith
  exact_mod_cast h2

end

end CC6Full
