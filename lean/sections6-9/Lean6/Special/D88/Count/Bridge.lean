import Lean6.Special.D88.Count.Order
import Lean6.Special.Comp.D88.Count.DimCheck
import Lean6.Special.K4.C4.GBSound
import Mathlib.RingTheory.MvPolynomial.MonomialOrder
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.MvPolynomial.Basic

/-!
# From the checkers' polynomials to `MvPolynomial (Fin n) (ZMod p)`

* `toMv n p f`: the polynomial of a term list (coefficients modulo `p`, exponent lists cut at `n`).
* `eval_toMv`: evaluating the term list at `y` extended by zero is `aeval y (toMv n p f)` (exponent lists of length at
  most `n`).
* `mem_span_of_good`: if the polynomials `B` vanish at every common zero of `F` in every commutative
  `ZMod p`-algebra (the soundness statement of the engines), then `toMv n p g` lies in the ideal generated by the
  `toMv n p f`, `f ∈ F`, for every `g ∈ B` (take the quotient ring as the algebra).
* `lead_toMv`: for a polynomial with `polyOK p n`, `degRevLex.degree (toMv n p g) = vec n (leadOf g)` and
  `toMv n p g ≠ 0`.
-/

namespace Lean6.Special.D88.Count

open Lean6.Special Lean6.Special.Comp Lean6.Special.Comp.Count MvPolynomial
open scoped MonomialOrder

variable {n p : ℕ}

/-- The polynomial of a term list. -/
noncomputable def toMv (n p : ℕ) (f : Poly ℕ) : MvPolynomial (Fin n) (ZMod p) :=
  (f.map fun t => monomial (vec n t.2) (t.1 : ZMod p)).sum

@[simp] theorem toMv_nil : toMv n p [] = 0 := rfl

theorem toMv_cons (t : ℕ × Mono) (f : Poly ℕ) :
    toMv n p (t :: f) = monomial (vec n t.2) (t.1 : ZMod p) + toMv n p f := by
  simp [toMv]

/-- A point of `Fin n → R`, extended by zero. -/
def ext {R : Type*} [Zero R] (y : Fin n → R) : ℕ → R := fun i => if h : i < n then y ⟨i, h⟩ else 0

theorem mono_eval_eq_prod {R : Type*} [CommRing R] (x : ℕ → R) :
    ∀ (m : Mono) (k : ℕ), Mono.eval x m k = ∏ i ∈ Finset.range m.length, x (k + i) ^ m.getD i 0
  | [], k => by simp [Mono.eval]
  | e :: m, k => by
    rw [Mono.eval, mono_eval_eq_prod x m (k + 1), List.length_cons, Finset.prod_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, add_zero]
    rw [mul_comm]
    congr 1
    refine Finset.prod_congr rfl fun i _ => ?_
    congr 2
    omega

theorem mono_eval_ext {R : Type*} [CommRing R] (y : Fin n → R) (m : Mono) (hm : m.length ≤ n) :
    Mono.eval (ext y) m 0 = ∏ i : Fin n, y i ^ (vec n m i) := by
  rw [mono_eval_eq_prod]
  have h1 : ∏ i ∈ Finset.range m.length, ext y (0 + i) ^ m.getD i 0 =
      ∏ i ∈ Finset.range n, ext y i ^ m.getD i 0 := by
    rw [← Finset.prod_range_mul_prod_Ico _ hm]
    have : ∏ i ∈ Finset.Ico m.length n, ext y i ^ m.getD i 0 = 1 := by
      refine Finset.prod_eq_one fun i hi => ?_
      rw [Finset.mem_Ico] at hi
      rw [List.getD_eq_default _ _ hi.1, pow_zero]
    rw [this, mul_one]
    simp
  rw [h1, ← Fin.prod_univ_eq_prod_range]
  refine Finset.prod_congr rfl fun i _ => ?_
  simp [ext, vec_apply]

/-- **Evaluation is `aeval`** on term lists with exponent lists of length at most `n`. -/
theorem eval_toMv [NeZero p] {R : Type*} [CommRing R] [Algebra (ZMod p) R] (y : Fin n → R) :
    ∀ (f : Poly ℕ), (∀ t ∈ f, t.2.length ≤ n) →
      Poly.eval (K4.C4.algH p R) (ext y) f = aeval y (toMv n p f)
  | [], _ => by simp
  | t :: f, hf => by
    rw [Poly.eval_cons, toMv_cons, map_add, eval_toMv y f (fun u hu => hf u (List.mem_cons_of_mem _ hu)),
      K4.C4.algH_f, aeval_monomial, mono_eval_ext y t.2 (hf t (List.mem_cons_self ..)),
      Finsupp.prod_fintype _ _ (fun i => pow_zero _)]

theorem aeval_mk_X (I : Ideal (MvPolynomial (Fin n) (ZMod p))) (q : MvPolynomial (Fin n) (ZMod p)) :
    aeval (fun i => Ideal.Quotient.mk I (X i)) q = Ideal.Quotient.mk I q := by
  have : (aeval (fun i => Ideal.Quotient.mk I (X i)) :
      MvPolynomial (Fin n) (ZMod p) →ₐ[ZMod p] MvPolynomial (Fin n) (ZMod p) ⧸ I) =
      Ideal.Quotient.mkₐ (ZMod p) I := by
    apply MvPolynomial.algHom_ext
    intro i
    simp
  rw [this]
  rfl

/-- **Membership from the engines' soundness**: polynomials that vanish at every common zero of `F` in every
commutative `ZMod p`-algebra lie in the ideal generated by `F`. -/
theorem mem_span_of_good [NeZero p] (F B : List (Poly ℕ)) (hF : ∀ f ∈ F, ∀ t ∈ f, t.2.length ≤ n)
    (hB : ∀ g ∈ B, ∀ t ∈ g, t.2.length ≤ n)
    (hgood : ∀ (R : Type) [CommRing R] [Algebra (ZMod p) R] (x : ℕ → R),
      (∀ f ∈ F, Poly.eval (K4.C4.algH p R) x f = 0) → ∀ g ∈ B, Poly.eval (K4.C4.algH p R) x g = 0) :
    ∀ g ∈ B, toMv n p g ∈ Ideal.span {q | ∃ f ∈ F, toMv n p f = q} := by
  intro g hg
  set I : Ideal (MvPolynomial (Fin n) (ZMod p)) := Ideal.span {q | ∃ f ∈ F, toMv n p f = q}
  set y : Fin n → MvPolynomial (Fin n) (ZMod p) ⧸ I := fun i => Ideal.Quotient.mk I (X i)
  have hzero : ∀ f ∈ F, Poly.eval (K4.C4.algH p (MvPolynomial (Fin n) (ZMod p) ⧸ I)) (ext y) f = 0 := by
    intro f hf
    rw [eval_toMv y f (hF f hf), aeval_mk_X, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span ⟨f, hf, rfl⟩
  have h := hgood (MvPolynomial (Fin n) (ZMod p) ⧸ I) (ext y) hzero g hg
  rw [eval_toMv y g (hB g hg), aeval_mk_X, Ideal.Quotient.eq_zero_iff_mem] at h
  exact h

/-! ## Leading terms -/

theorem polyOK_spec {g : Poly ℕ} (h : polyOK p n g = true) :
    g ≠ [] ∧ (∀ t ∈ g, 0 < t.1 ∧ t.1 < p ∧ t.2.length = n) ∧ sortedStrict g = true := by
  unfold polyOK at h
  simp only [Bool.and_eq_true, Bool.not_eq_true', List.isEmpty_eq_false_iff, List.all_eq_true,
    decide_eq_true_eq, beq_iff_eq] at h
  obtain ⟨⟨hne, hall⟩, hs⟩ := h
  exact ⟨hne, fun t ht => ⟨(hall t ht).1.1, (hall t ht).1.2, (hall t ht).2⟩, hs⟩

theorem grev_trans {a b c : Mono} (ha : a.length = n) (hb : b.length = n) (hc : c.length = n)
    (hab : grevGtStd a b = true) (hbc : grevGtStd b c = true) : grevGtStd a c = true := by
  rw [grevGtStd_iff ha hb] at hab
  rw [grevGtStd_iff hb hc] at hbc
  rw [grevGtStd_iff ha hc]
  exact lt_trans hbc hab

/-- In a strictly decreasing list every later monomial is smaller than the first. -/
theorem sorted_head_gt : ∀ (t : ℕ × Mono) (rest : Poly ℕ), sortedStrict (t :: rest) = true →
    (∀ u ∈ t :: rest, u.2.length = n) → ∀ u ∈ rest, vec n u.2 ≺[degRevLex (Fin n)] vec n t.2
  | t, [], _, _ => by simp
  | t, v :: rest, hs, hl => by
    simp only [sortedStrict, Bool.and_eq_true] at hs
    obtain ⟨htv, hs'⟩ := hs
    have hl' : ∀ u ∈ v :: rest, u.2.length = n := fun u hu => hl u (List.mem_cons_of_mem _ hu)
    have ih := sorted_head_gt v rest hs' hl'
    have htv' : vec n v.2 ≺[degRevLex (Fin n)] vec n t.2 :=
      (grevGtStd_iff (hl t (List.mem_cons_self ..)) (hl' v (List.mem_cons_self ..))).mp htv
    intro u hu
    rcases List.mem_cons.mp hu with rfl | hu
    · exact htv'
    · exact lt_trans (ih u hu) htv'

theorem support_toMv_subset (f : Poly ℕ) :
    (toMv n p f).support ⊆ (f.map fun t => vec n t.2).toFinset := by
  classical
  induction f with
  | nil => simp
  | cons t f ih =>
    rw [toMv_cons]
    refine (support_add).trans ?_
    intro c hc
    rcases Finset.mem_union.mp hc with hc | hc
    · have := support_monomial_subset hc
      rw [Finset.mem_singleton] at this
      simp [this]
    · have := ih hc
      simp only [List.mem_toFinset, List.mem_map] at this ⊢
      obtain ⟨u, hu, rfl⟩ := this
      exact ⟨u, List.mem_cons_of_mem _ hu, rfl⟩

theorem natCast_ne_zero_of_lt {c : ℕ} (h0 : 0 < c) (hp : c < p) : (c : ZMod p) ≠ 0 := by
  rw [Ne, ZMod.natCast_eq_zero_iff]
  intro hd
  exact absurd (Nat.le_of_dvd h0 hd) (not_le.mpr hp)

/-- **The leading term of a checked polynomial**: its degree in `degRevLex` is the first monomial, and it is not zero. -/
theorem lead_toMv {g : Poly ℕ} (h : polyOK p n g = true) :
    (degRevLex (Fin n)).degree (toMv n p g) = vec n (leadOf g) ∧ toMv n p g ≠ 0 := by
  classical
  obtain ⟨hne, hall, hs⟩ := polyOK_spec h
  obtain ⟨t, rest, rfl⟩ : ∃ t rest, g = t :: rest := by
    cases g with
    | nil => exact absurd rfl hne
    | cons t rest => exact ⟨t, rest, rfl⟩
  have hc : (t.1 : ZMod p) ≠ 0 :=
    natCast_ne_zero_of_lt (hall t (List.mem_cons_self ..)).1 (hall t (List.mem_cons_self ..)).2.1
  have hlt := sorted_head_gt t rest hs (fun u hu => (hall u hu).2.2)
  have hdeg_m : (degRevLex (Fin n)).degree (monomial (vec n t.2) (t.1 : ZMod p)) = vec n t.2 := by
    rw [MonomialOrder.degree_monomial, ite_eq_right hc]
  have hlc_m : (degRevLex (Fin n)).leadingCoeff (monomial (vec n t.2) (t.1 : ZMod p)) = (t.1 : ZMod p) :=
    MonomialOrder.leadingCoeff_monomial _
  simp only [leadOf]
  rw [toMv_cons]
  by_cases hr : rest = []
  · subst hr
    simp only [toMv_nil, add_zero]
    refine ⟨hdeg_m, ?_⟩
    intro h0
    rw [monomial_eq_zero] at h0
    exact hc h0
  · -- the rest is strictly below the first monomial
    obtain ⟨v, hv⟩ : ∃ v, v ∈ rest := List.exists_mem_of_ne_nil rest hr
    have hpos : 0 ≺[degRevLex (Fin n)] vec n t.2 := by
      refine lt_of_le_of_lt ?_ (hlt v hv)
      rw [map_zero]
      exact MonomialOrder.zero_le _ _
    have hrest : (degRevLex (Fin n)).degree (toMv n p rest) ≺[degRevLex (Fin n)] vec n t.2 := by
      rw [MonomialOrder.degree_lt_iff hpos]
      intro c hcs
      have := support_toMv_subset rest hcs
      simp only [List.mem_toFinset, List.mem_map] at this
      obtain ⟨u, hu, rfl⟩ := this
      exact hlt u hu
    rw [← hdeg_m] at hrest
    refine ⟨by rw [MonomialOrder.degree_add_of_lt hrest, hdeg_m], ?_⟩
    intro h0
    have hlc := MonomialOrder.leadingCoeff_add_of_lt hrest
    rw [h0, hlc_m, MonomialOrder.leadingCoeff_zero] at hlc
    exact hc hlc.symm

end Lean6.Special.D88.Count
