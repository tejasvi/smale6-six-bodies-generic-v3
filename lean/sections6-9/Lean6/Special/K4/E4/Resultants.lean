/-! ## T2 -/

/-- The tournament T2. -/
def sigT2 : Fin 4 → Fin 4 → ℤ := fun k l => if k = l then 0 else if (k = 1 ∧ l = 3) then -1 else if (k = 3 ∧ l = 1) then 1 else if k < l then 1 else -1

theorem e_T2 (t s : ℂ) :
    Gsig (fun _ => 1) sigT2 ![0, 1, t, s] 0 = s^2*t^2 + s^2 + t^2 ∧
