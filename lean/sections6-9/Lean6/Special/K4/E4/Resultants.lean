/-!
# The resultants in the proof of Lemma 7.7 (the forms `G_σ`)

Generated by `gen/e4/gen_resultants.py` (SymPy, exact). For the tournaments `T1`, `T2`, `T3` of the paper
(`σ_{kl} = 1` for `k < l`, except `σ_{24} = −1` in `T2` and `σ_{14} = −1` in `T3`; Lean's bodies are `0, …, 3`) and
`ξ = (0, 1, t, s)`, `e_k` is the form `G_σ,k` of `Final.lean` at `μ = (1, 1, 1, 1)`, i.e. the numerator of
`Σ_{l ≠ k} σ_{kl} (ξ_k − ξ_l)^{−2}` (`e_T*`).

* **What the proof uses** (`no_zero_T*`): no `(t, s) ∈ ℂ²` is a common zero of `e_1, e_2, e_3`. From the identities
  `A e_1 + B e_2 = R_1`, `A₂ e_1 + B₂ e_3 = t⁴ R_2′`, `U R_1 + V R_2′ = c` (`c ≠ 0` an integer), checked by
  `linear_combination`, and `R_1(0) = 1`.
* **The printed values** (`res12_T*`, `res13_T*`, `resR_T*`): `Res_s(e_1, e_2) = R_1`, `Res_s(e_1, e_3) = t⁴ R_2′` and
  `Res_t(R_1, R_2′)` as printed, with Mathlib's `Polynomial.resultant` (the determinant of the Sylvester matrix):
  the `4 × 4` determinants over `ℤ[t]` by expansion, the `16 × 16` ones by an exact LU factorization over `ℚ`.
-/

namespace Lean6.Special.K4.E4

open Polynomial

/-- `∑ i < l.length, l_i X^i`. -/
noncomputable def ofListR {R : Type*} [CommRing R] (l : List R) : R[X] :=
  ∑ i ∈ Finset.range l.length, C (l.getD i 0) * X ^ i

/-- `ofListR` over `ℤ`. -/
noncomputable abbrev ofList (l : List ℤ) : ℤ[X] := ofListR l

theorem coeff_ofListR {R : Type*} [CommRing R] (l : List R) (k : ℕ) : (ofListR l).coeff k = l.getD k 0 := by
  simp only [ofListR, finsetSum_coeff, coeff_C_mul, coeff_X_pow, mul_ite, mul_one, mul_zero]
  rw [Finset.sum_ite_eq]
  split
  · rfl
  · rename_i h
    rw [List.getD_eq_default _ _ (by simpa using h)]

/-- Mathlib's Sylvester matrix of `ofListR a`, `ofListR b`, with `if` in place of `Fin.addCases`. -/
def sylvF {R : Type*} [Zero R] (a b : List R) (m n : ℕ) (i j : Fin (m + n)) : R :=
  if (j : ℕ) < m then (if (j : ℕ) ≤ i ∧ (i : ℕ) ≤ j + n then b.getD (i - j) 0 else 0)
  else (if (j : ℕ) - m ≤ i ∧ (i : ℕ) ≤ (j : ℕ) - m + m then a.getD (i - ((j : ℕ) - m)) 0 else 0)

theorem sylvester_ofListR {R : Type*} [CommRing R] (a b : List R) (m n : ℕ) :
    sylvester (ofListR a) (ofListR b) m n = Matrix.of (sylvF a b m n) := by
  ext i j
  induction j using Fin.addCases with
  | left j => simp [sylvester, sylvF, coeff_ofListR, Set.mem_Icc]
  | right j => simp [sylvester, sylvF, coeff_ofListR, Set.mem_Icc]

/-- A matrix from its rows. -/
def matQ {n : ℕ} (rows : List (List ℚ)) : Matrix (Fin n) (Fin n) ℚ := Matrix.of fun i j => (rows.getD i []).getD j 0

/-- `L` is unit lower triangular (checked entry by entry). -/
def lowUnitOK {n : ℕ} (L : Matrix (Fin n) (Fin n) ℚ) : Bool :=
  (List.finRange n).all fun i => (List.finRange n).all fun j =>
    if i < j then L i j == 0 else if i = j then L i j == 1 else true

/-- `U` is upper triangular (checked entry by entry). -/
def upOK {n : ℕ} (U : Matrix (Fin n) (Fin n) ℚ) : Bool :=
  (List.finRange n).all fun i => (List.finRange n).all fun j => if j < i then U i j == 0 else true

/-- The determinant from an LU factorization `M = L U`, `L` unit lower and `U` upper triangular. -/
theorem det_of_LU {n : ℕ} (M L U : Matrix (Fin n) (Fin n) ℚ) (hLU : M = L * U) (hL : lowUnitOK L = true)
    (hU : upOK U = true) : M.det = ∏ i, U i i := by
  simp only [lowUnitOK, upOK, List.all_eq_true, List.mem_finRange, true_implies] at hL hU
  have hL0 : ∀ i j : Fin n, i < j → L i j = 0 := fun i j h => by
    have := hL i j; simp [h] at this; exact this
  have hL1 : ∀ i : Fin n, L i i = 1 := fun i => by
    have := hL i i; simp at this; exact this
  have hU0 : ∀ i j : Fin n, j < i → U i j = 0 := fun i j h => by
    have := hU i j; simp [h] at this; exact this
  rw [hLU, Matrix.det_mul, Matrix.det_of_isLowerTriangular L (fun i j h => hL0 i j h),
    Matrix.det_of_isUpperTriangular (fun i j h => hU0 i j h)]
  simp [hL1]

/-- The integer resultant of `ofList a`, `ofList b` from an LU factorization of the Sylvester matrix over `ℚ`. -/
theorem resultant_of_LU (a b : List ℤ) (m n : ℕ) (L U : Matrix (Fin (m + n)) (Fin (m + n)) ℚ) (c : ℤ)
    (hLU : (Matrix.of fun i j => (Int.cast (sylvF a b m n i j) : ℚ)) = L * U)
    (hL : lowUnitOK L = true) (hU : upOK U = true) (hc : ∏ i, U i i = c) :
    resultant (ofList a) (ofList b) m n = c := by
  have h := det_of_LU _ L U hLU hL hU
  rw [hc] at h
  have e : (Matrix.of fun i j => (Int.cast (sylvF a b m n i j) : ℚ)) =
      (Int.castRingHom ℚ).mapMatrix (Matrix.of (sylvF a b m n)) := by
    ext i j; simp
  rw [e, ← RingHom.map_det, eq_intCast] at h
  rw [resultant, sylvester_ofListR]
  exact_mod_cast h

/-! ## T1 -/

/-- The tournament T1. -/
def sigT1 : Fin 4 → Fin 4 → ℤ := fun k l => if k < l then 1 else if l < k then -1 else 0

theorem e_T1 (t s : ℂ) :
    Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 0 = s^2*t^2 + s^2 + t^2 ∧
    Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 1 = -s^2*t^2 + 2*s^2*t + 2*s*t^2 - 4*s*t + 1 ∧
    Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 2 = -2*s^2*t^2 + 2*s^2*t - s^2 + 4*s*t^3 - 4*s*t^2 + 2*s*t - t^4 := by
  refine ⟨?_, ?_, ?_⟩ <;>
    simp [Gsig, sigT1, Fin.sum_univ_four, Fin.prod_univ_four] <;> ring

/-- `R_1` of T1. -/
noncomputable def R1T1 : ℤ[X] := ofList [1, 0, 2, -4, 19, -20, 26, -20, 5]

/-- `R_2′` of T1. -/
noncomputable def R2T1 : ℤ[X] := ofList [5, -20, 42, -52, 47, -28, 14, 0, 1]

theorem R1T1_eq : R1T1 = 5*X^8 - 20*X^7 + 26*X^6 - 20*X^5 + 19*X^4 - 4*X^3 + 2*X^2 + 1 := by
  simp [R1T1, ofList, ofListR, Finset.sum_range_succ]; ring

theorem R2T1_eq : R2T1 = X^8 + 14*X^6 - 28*X^5 + 47*X^4 - 52*X^3 + 42*X^2 - 20*X + 5 := by
  simp [R2T1, ofList, ofListR, Finset.sum_range_succ]; ring

theorem R1T1_zero : R1T1.eval 0 = 1 := by
  simp [R1T1_eq]

/-- **No common zero** of `e_1, e_2, e_3` for T1. -/
theorem no_zero_T1 (t s : ℂ) (h1 : Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 0 = 0)
    (h2 : Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 1 = 0) (h3 : Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 2 = 0) :
    False := by
  obtain ⟨e1, e2, e3⟩ := e_T1 t s
  rw [e1] at h1
  rw [e2] at h2
  rw [e3] at h3
  have hR1 : 5*t^8 - 20*t^7 + 26*t^6 - 20*t^5 + 19*t^4 - 4*t^3 + 2*t^2 + 1 = 0 := by
    linear_combination (-2*s*t^6 + 8*s*t^5 - 10*s*t^4 + 8*s*t^3 - 8*s*t^2 + 5*t^6 - 20*t^5 + 25*t^4 - 18*t^3 + 17*t^2 - 2*t) * h1 + (-2*s*t^6 + 4*s*t^5 - 4*s*t^4 + 8*s*t^3 - 2*s*t^2 + 4*s*t + t^6 - 2*t^5 + 2*t^4 - 2*t^3 + 2*t^2 + 1) * h2
  have hR2 : t ^ 4 * (t^8 + 14*t^6 - 28*t^5 + 47*t^4 - 52*t^3 + 42*t^2 - 20*t + 5) = 0 := by
    linear_combination (-8*s*t^7 + 16*s*t^6 - 24*s*t^5 + 24*s*t^4 - 18*s*t^3 + 8*s*t^2 - 2*s*t + 14*t^8 - 30*t^7 + 49*t^6 - 54*t^5 + 43*t^4 - 20*t^3 + 5*t^2) * h1 + (-4*s*t^7 + 4*s*t^6 - 10*s*t^5 + 8*s*t^4 - 8*s*t^3 + 4*s*t^2 - 2*s*t - t^8 - 2*t^5 + 2*t^4 - 2*t^3 + t^2) * h3
  have ht : t ≠ 0 := by
    rintro rfl
    norm_num at hR1
  have hR2' : t^8 + 14*t^6 - 28*t^5 + 47*t^4 - 52*t^3 + 42*t^2 - 20*t + 5 = 0 := by
    rcases mul_eq_zero.mp hR2 with h | h
    · exact absurd (pow_eq_zero_iff (by norm_num) |>.mp h) ht
    · exact h
  have hc : (73350900 : ℂ) = 0 := by
    linear_combination (-30091591*t^7 - 18608713*t^6 - 426090582*t^5 + 585495946*t^4 - 955791328*t^3 + 875295348*t^2 - 552200805*t + 128148320) * hR1 + (150457955*t^7 - 508788255*t^6 + 434248646*t^5 - 231438342*t^4 + 369720592*t^3 + 132150168*t^2 + 66602225*t - 10959484) * hR2'
  norm_num at hc

/-- `e_1` of T1 in `ℤ[t][s]`. -/
noncomputable def e1pT1 : ℤ[X][X] := ofListR [X^2, 0, X^2 + 1]

/-- `e_2` of T1 in `ℤ[t][s]`. -/
noncomputable def e2pT1 : ℤ[X][X] := ofListR [1, 2*X^2 - 4*X, -X^2 + 2*X]

/-- `e_3` of T1 in `ℤ[t][s]`. -/
noncomputable def e3pT1 : ℤ[X][X] := ofListR [-X^4, 4*X^3 - 4*X^2 + 2*X, -2*X^2 + 2*X - 1]

theorem e1pT1_eval (t s : ℂ) : (e1pT1.map (eval₂RingHom (Int.castRingHom ℂ) t)).eval s =
    Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 0 := by
  rw [(e_T1 t s).1]; simp [e1pT1, ofListR, Finset.sum_range_succ]; ring

theorem e2pT1_eval (t s : ℂ) : (e2pT1.map (eval₂RingHom (Int.castRingHom ℂ) t)).eval s =
    Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 1 := by
  rw [(e_T1 t s).2.1]; simp [e2pT1, ofListR, Finset.sum_range_succ]; ring

theorem e3pT1_eval (t s : ℂ) : (e3pT1.map (eval₂RingHom (Int.castRingHom ℂ) t)).eval s =
    Gsig (fun _ => 1) sigT1 ![0, 1, t, s] 2 := by
  rw [(e_T1 t s).2.2]; simp [e3pT1, ofListR, Finset.sum_range_succ]; ring

/-- `Res_s(e_1, e_2) = R_1` (T1). -/
theorem res12_T1 : resultant e1pT1 e2pT1 2 2 = R1T1 := by
  rw [R1T1_eq, resultant, e1pT1, e2pT1, sylvester_ofListR, Matrix.det_succ_row_zero]
  simp [Fin.sum_univ_succ, Matrix.det_fin_three, sylvF, Fin.succAbove]
  ring

/-- `Res_s(e_1, e_3) = t⁴ R_2′` (T1). -/
theorem res13_T1 : resultant e1pT1 e3pT1 2 2 = X ^ 4 * R2T1 := by
  rw [R2T1_eq, resultant, e1pT1, e3pT1, sylvester_ofListR, Matrix.det_succ_row_zero]
  simp [Fin.sum_univ_succ, Matrix.det_fin_three, sylvF, Fin.succAbove]
