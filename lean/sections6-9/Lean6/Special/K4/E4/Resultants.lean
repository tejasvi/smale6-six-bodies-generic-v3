    Gsig (fun _ => 1) sigT2 ![0, 1, t, s] 2 = -2*s^2*t^2 + 2*s^2*t - s^2 + 4*s*t^3 - 4*s*t^2 + 2*s*t - t^4 := by
  refine ⟨?_, ?_, ?_⟩ <;>
    simp [Gsig, sigT2, Fin.sum_univ_four, Fin.prod_univ_four] <;> ring

