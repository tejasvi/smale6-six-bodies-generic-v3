/-- Case (III): `Σ p³ = (s₀³ + 3 s₀ (s₁² + s₂² + s₃²) + 6 s₁ s₂ s₃)/16`. -/
theorem caseIII_cubes (s0 s1 s2 s3 : ℂ)  :
    (s0/4 - s1/4 - s2/4 + s3/4)^3 + (s0/4 - s1/4 + s2/4 - s3/4)^3 + (s0/4 + s1/4 - s2/4 - s3/4)^3 + (s0/4 + s1/4 + s2/4 + s3/4)^3 = s0^3/16 + 3*s0*(s1^2 + s2^2 + s3^2)/16 + 3*s1*s2*s3/8 := by
  ring

