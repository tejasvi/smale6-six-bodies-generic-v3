/-- Case (I), three `p_k` equal to `r₁` and one to `r₂`: `r₁² − r₁ + 1 = 0` and `Σ p³ = 3r₁³ + r₂³ = −6 r₁`, a root of `x² + 6x + 36` (that is `−3 ∓ 3√3 i`). -/
theorem caseI_three_one (r1 r2 : ℂ) (hsum : r1 + r2 = -1) (hprod : r1*r2 = -3*r1 - r2) :
    r1^2 - r1 + 1 = 0 ∧ 3*r1^3 + r2^3 = -6*r1 ∧ 18*r1^3 + 6*r2^3 + (3*r1^3 + r2^3)^2 + 36 = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · linear_combination (r1 + 1) * hsum + (-1) * hprod
  · linear_combination (3*r1^2 - r1*r2 + 3*r1 + r2^2 - r2) * hsum + (1 - 2*r1) * hprod
  · linear_combination (9*r1^5 - 5*r1^4*r2 + 3*r1^4 + 5*r1^3*r2^2 - 2*r1^3*r2 - 27*r1^3 + r1^2*r2^3 - 3*r1^2*r2^2 + 6*r1^2*r2 - r1*r2^4 + 2*r1*r2^3 - 3*r1*r2^2 - 2*r1*r2 + 57*r1 + r2^5 - r2^4 + r2^3 + 5*r2^2 - 5*r2 + 36) * hsum + (-4*r1^4 + 8*r1^3 + 15*r1^2 - 19*r1 - 31) * hprod

/-- Case (I), two `p_k` equal to `r₁` and two to `r₂`: `S = −2`, `r₁ r₂ = 2`, `Σ p³ = 10`. -/
theorem caseI_two_two (r1 r2 : ℂ) (hsum : r1 + r2 = -1) (hprod : r1*r2 = -2*r1 - 2*r2) :
    2*r1 + 2*r2 = -2 ∧ r1*r2 = 2 ∧ 2*r1^3 + 2*r2^3 = 10 := by
  refine ⟨?_, ?_, ?_⟩
  · linear_combination (2) * hsum
  · linear_combination (-2) * hsum + (1) * hprod
  · linear_combination (2*r1^2 - 2*r1*r2 - 2*r1 + 2*r2^2 - 2*r2 - 10) * hsum + (6) * hprod

/-- Case (II): subtracting the equations of `E p = p ∘ p` gives `(p₂ − p₃)(p₂ + p₃ + 1) = 0` and `(p₁ − p₄)(p₁ + p₄ + j) = 0` (Lean indices `0, …, 3`). -/
theorem caseII_diff (w p0 p1 p2 p3 : ℂ) (e1 : p1 + p2 + p3*w = p0^2) (e2 : p0 + p2 + p3 = p1^2) (e3 : p0 + p1 + p3 = p2^2) (e4 : p0*w + p1 + p2 = p3^2) :
    (p1 - p2)*(p1 + p2 + 1) = 0 ∧ (p0 - p3)*(p0 + p3 + w) = 0 := by
  refine ⟨?_, ?_⟩
  · linear_combination (-1) * e2 + (1) * e3
  · linear_combination (-1) * e1 + (1) * e4

/-- Case (II), `p₂ = p₃ = a = −ζ b`, `p₁ = p₄ = b`: with `2 − ζ = ζ² b` and `b = j − 2ζ` (the equations divided by `b ≠ 0`), `ζ² − 4ζ + j = 0`. -/
theorem caseII_equal_eq (w z b : ℂ) (hz3 : z^3 = 1) (k1 : 2 - z = b*z^2) (k2 : b = w - 2*z) :
    w + z^2 - 4*z = 0 := by
  linear_combination (-b) * hz3 + (-z) * k1 + (-1) * k2

/-- The cube roots of unity: `(ζ − 1)(ζ − j)(ζ − j²) = ζ³ − 1`. -/
theorem cube_roots_factor (w z : ℂ) (hw : w^2 + w + 1 = 0) :
    (-w + z)*(-w^2 + z)*(z - 1) = z^3 - 1 := by
  linear_combination (w*z - w - z^2 + 1) * hw

/-- Case (II), `p₂ = p₃ = a`, `p₁ + p₄ = −j`: `a² − a + j = 0`, `p₁ p₄ = j² − 2a` and `Σ p³ = 2a(1 − 4j) + 2 − 2j`. -/
theorem caseII_b (w a p1 p4 : ℂ) (hw : w^2 + w + 1 = 0) (h1 : 2*a + p4*w = p1^2) (h2 : a + p1 + p4 = a^2) (h4 : 2*a + p1*w = p4^2) (hs : p1 + p4 = -w) :
    a^2 - a + w = 0 ∧ p1*p4 = -2*a + w^2 ∧ 2*a^3 + p1^3 + p4^3 = 2*a*(1 - 4*w) - 2*w + 2 := by
  refine ⟨?_, ?_, ?_⟩
  · linear_combination (-1) * h2 + (1) * hs
  · linear_combination (1) * h1 + (p1 - w) * hs
  · linear_combination (-2*p1 - 2*p4 - 2) * hw + (p1 + 2*p4 + 2*w) * h1 + (-2*a - 2) * h2 + (-p4 + 2*w) * h4 + (2*p1^2 + 2*w + 4) * hs

/-- Case (II), at `a (1 − 4j) = j − 1`: `(1 − 4j)² (a² − a + j) = 21 − 3j`. -/
theorem caseII_b_value (w a : ℂ) (hw : w^2 + w + 1 = 0) (ha : a*(1 - 4*w) = w - 1) :
    (1 - 4*w)^2*(a^2 - a + w) = 21 - 3*w := by
  linear_combination (16*w - 19) * hw + (-4*a*w + a + 5*w - 2) * ha

/-- Case (II), `p₂ + p₃ = −1`, `p₁ = p₄ = b`: `b² − j b + 1 = 0`, `p₂ p₃ = 1 − 2b` and `Σ p³ = 2b(j² − 4) + 2 − 2j`. -/
theorem caseII_c (w b p2 p3 : ℂ) (hw : w^2 + w + 1 = 0) (e1 : b*w + p2 + p3 = b^2) (e2 : 2*b + p3 = p2^2) (e3 : 2*b + p2 = p3^2) (hs : p2 + p3 = -1) :
    b^2 - b*w + 1 = 0 ∧ p2*p3 = 1 - 2*b ∧ 2*b^3 + p2^3 + p3^3 = 2*b*(w^2 - 4) - 2*w + 2 := by
  refine ⟨?_, ?_, ?_⟩
  · linear_combination (-1) * e1 + (1) * hs
  · linear_combination (1) * e2 + (p2 - 1) * hs
  · linear_combination (-2*b - 2*w) * e1 + (2 - p2) * e2 + (-p3) * e3 + (4*b + 2*p2 + 2*w - 2) * hs

/-- Case (II), at `b (j² − 4) = j − 1`: `(j² − 4)² (b² − j b + 1) = 21 − 3j`. -/
theorem caseII_c_value (w b : ℂ) (hw : w^2 + w + 1 = 0) (hb : b*(w^2 - 4) = w - 1) :
    (w^2 - 4)^2*(b^2 - b*w + 1) = 21 - 3*w := by
  linear_combination (w - 4) * hw + (b*w^2 - 4*b - w^3 + 5*w - 1) * hb

/-- Case (II), `p₂ + p₃ = −1`, `p₁ + p₄ = −j`: `p₂ p₃ = −j²`, `p₁ p₄ = −j`, `Σ p³ = 4 + 6j`. -/
theorem caseII_d (w p0 p1 p2 p3 : ℂ) (hw : w^2 + w + 1 = 0) (e1 : p1 + p2 + p3*w = p0^2) (e2 : p0 + p2 + p3 = p1^2) (e3 : p0 + p1 + p3 = p2^2) (e4 : p0*w + p1 + p2 = p3^2) (hs1 : p1 + p2 = -1) (hs2 : p0 + p3 = -w) :
    p1*p2 = -w^2 ∧ p0*p3 = -w ∧ p0^3 + p1^3 + p2^3 + p3^3 = 6*w + 4 := by
  refine ⟨?_, ?_, ?_⟩
  · linear_combination (1) * hw + (1) * e2 + (p1 - 1) * hs1 + (-1) * hs2
  · linear_combination (1) * hw + (1) * e1 + (-1) * hs1 + (p0 - w) * hs2
  · linear_combination (-2*p0 - 2*p3 - 2) * hw + (p0 + 2*p3 + 2*w) * e1 + (2 - p1) * e2 + (-p2) * e3 + (-p3 + 2*w) * e4 + (2*p1 - 4*w - 2) * hs1 + (2*p0^2 + 2*w) * hs2

/-- Case (III): `4 + 2λ₂ + 2λ₃ = 0` and `8λ₂ + 8λ₃ + 4λ₂λ₃ = 0` for `λ₂ = −2 − 2j`, `λ₃ = 2j`. -/
theorem caseIII_lambda (w : ℂ) (hw : w^2 + w + 1 = 0) :
    0 = 0 ∧ 2*w*(-8*w - 8) - 16 = 0 := by
  refine ⟨?_, ?_⟩
  · linear_combination 0
  · linear_combination (-16) * hw

/-- Case (III): `E χ_i = λ_i χ_i` with eigenvalues `0, 2, λ₂, λ₃` (row by row). -/
theorem caseIII_eigen (w : ℂ) (hw : w^2 + w + 1 = 0) :
    w^2 + w + 1 = 0 ∧ w^2 + w + 1 = 0 ∧ w^2 + w + 1 = 0 ∧ w^2 + w + 1 = 0 ∧ -w^2 - w + 1 = 2 ∧ -w^2 - w + 1 = 2 ∧ w^2 + w - 1 = -2 ∧ w^2 + w - 1 = -2 ∧ w^2 - w - 1 = -2*w - 2 ∧ -w^2 + w + 1 = 2*w + 2 ∧ w^2 - w - 1 = -2*w - 2 ∧ -w^2 + w + 1 = 2*w + 2 ∧ -w^2 + w - 1 = 2*w ∧ w^2 - w + 1 = -2*w ∧ w^2 - w + 1 = -2*w ∧ -w^2 + w - 1 = 2*w := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · linear_combination (1) * hw
  · linear_combination (1) * hw
  · linear_combination (1) * hw
  · linear_combination (1) * hw
  · linear_combination (-1) * hw
  · linear_combination (-1) * hw
  · linear_combination (1) * hw
  · linear_combination (1) * hw
  · linear_combination (1) * hw
  · linear_combination (-1) * hw
  · linear_combination (1) * hw
  · linear_combination (-1) * hw
  · linear_combination (-1) * hw
  · linear_combination (1) * hw
  · linear_combination (1) * hw
  · linear_combination (-1) * hw

/-- Case (III): with `p = ¼ Σ s_i χ_i`, the combinations `Σ_k χ_{m,k} (E p − p ∘ p)_k` are `−¼`, `½`, `½`, `½` times the four equations `s₀² + s₁² + s₂² + s₃² = 0`, `s₁(4 − s₀) = s₂ s₃`, `s₂(2λ₂ − s₀) = s₁ s₃`, `s₃(2λ₃ − s₀) = s₁ s₂`. -/
theorem caseIII_system (w s0 s1 s2 s3 : ℂ) (hw : w^2 + w + 1 = 0) :
    s0 + w^2*(s0/4 - s1/4 - s2/4 + s3/4) + w^2*(s0/4 - s1/4 + s2/4 - s3/4) + w^2*(s0/4 + s1/4 - s2/4 - s3/4) + w^2*(s0/4 + s1/4 + s2/4 + s3/4) + w*(s0/4 - s1/4 - s2/4 + s3/4) + w*(s0/4 - s1/4 + s2/4 - s3/4) + w*(s0/4 + s1/4 - s2/4 - s3/4) + w*(s0/4 + s1/4 + s2/4 + s3/4) - (s0/4 - s1/4 - s2/4 + s3/4)^2 - (s0/4 - s1/4 + s2/4 - s3/4)^2 - (s0/4 + s1/4 - s2/4 - s3/4)^2 - (s0/4 + s1/4 + s2/4 + s3/4)^2 = -s0^2/4 - s1^2/4 - s2^2/4 - s3^2/4 ∧ s1 + w^2*(s0/4 - s1/4 - s2/4 + s3/4) + w^2*(s0/4 - s1/4 + s2/4 - s3/4) - w^2*(s0/4 + s1/4 - s2/4 - s3/4) - w^2*(s0/4 + s1/4 + s2/4 + s3/4) + w*(s0/4 - s1/4 - s2/4 + s3/4) + w*(s0/4 - s1/4 + s2/4 - s3/4) - w*(s0/4 + s1/4 - s2/4 - s3/4) - w*(s0/4 + s1/4 + s2/4 + s3/4) + (s0/4 - s1/4 - s2/4 + s3/4)^2 + (s0/4 - s1/4 + s2/4 - s3/4)^2 - (s0/4 + s1/4 - s2/4 - s3/4)^2 - (s0/4 + s1/4 + s2/4 + s3/4)^2 = s1*(4 - s0)/2 - s2*s3/2 ∧ -s2 - w^2*(s0/4 - s1/4 - s2/4 + s3/4) + w^2*(s0/4 - s1/4 + s2/4 - s3/4) - w^2*(s0/4 + s1/4 - s2/4 - s3/4) + w^2*(s0/4 + s1/4 + s2/4 + s3/4) + w*(s0/4 - s1/4 - s2/4 + s3/4) - w*(s0/4 - s1/4 + s2/4 - s3/4) + w*(s0/4 + s1/4 - s2/4 - s3/4) - w*(s0/4 + s1/4 + s2/4 + s3/4) + (s0/4 - s1/4 - s2/4 + s3/4)^2 - (s0/4 - s1/4 + s2/4 - s3/4)^2 + (s0/4 + s1/4 - s2/4 - s3/4)^2 - (s0/4 + s1/4 + s2/4 + s3/4)^2 = -s1*s3/2 + s2*(-s0 - 4*w - 4)/2 ∧ -s3 - w^2*(s0/4 - s1/4 - s2/4 + s3/4) + w^2*(s0/4 - s1/4 + s2/4 - s3/4) + w^2*(s0/4 + s1/4 - s2/4 - s3/4) - w^2*(s0/4 + s1/4 + s2/4 + s3/4) + w*(s0/4 - s1/4 - s2/4 + s3/4) - w*(s0/4 - s1/4 + s2/4 - s3/4) - w*(s0/4 + s1/4 - s2/4 - s3/4) + w*(s0/4 + s1/4 + s2/4 + s3/4) - (s0/4 - s1/4 - s2/4 + s3/4)^2 + (s0/4 - s1/4 + s2/4 - s3/4)^2 + (s0/4 + s1/4 - s2/4 - s3/4)^2 - (s0/4 + s1/4 + s2/4 + s3/4)^2 = -s1*s2/2 + s3*(-s0 + 4*w)/2 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · linear_combination (s0) * hw
  · linear_combination (-s1) * hw
  · linear_combination (s2) * hw
